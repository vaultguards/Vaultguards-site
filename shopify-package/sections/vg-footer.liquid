{% comment %}
  VAULTGUARDS — Footer
  INSTALL: Online Store > Themes > Edit code > Sections > Add a new section
  > name it "vg-footer" > paste this whole file in > Save.
  Then: Customize theme > Add section at the very bottom of the page
  > choose "VG Footer". Recommended: hide your theme's default footer so
  you don't get two footers stacked.

  Collection links below use "collection_tag" / "collection_psa" settings
  so you can point them at your REAL collection handles (on your live
  store today these are "tag-guards-shimmer-series" and "shimmer-series")
  without editing code — just set them in Customize.
{% endcomment %}

<link rel="stylesheet" href="{{ 'vg-theme.css' | asset_url }}">

<div class="vg-root">
  <footer style="background:var(--vg-navy-900); color:var(--vg-ivory-200); padding:64px 0 32px;">
    <div class="vg-container">
      <div class="vg-footer-grid" style="display:grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap:40px;">
        <div>
          <div class="vg-logo" style="color:#fff;">
            <img src="{{ 'vaultguards-logo.png' | asset_url }}" alt="{{ shop.name }}" class="vg-logo-mark"> {{ shop.name | default: 'Vaultguards' }}
          </div>
          <p style="color:var(--vg-navy-300); font-size:14px; max-width:280px; margin-top:14px;">
            {{ section.settings.tagline }}
          </p>
        </div>

        <div>
          <div style="font-size:12px; letter-spacing:0.1em; text-transform:uppercase; color:var(--vg-gold-400); margin-bottom:14px;">Shop</div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:14px; color:var(--vg-navy-300);">
            {% if section.settings.collection_tag != blank %}
              <a href="{{ collections[section.settings.collection_tag].url }}">TAG Guards</a>
            {% endif %}
            {% if section.settings.collection_psa != blank %}
              <a href="{{ collections[section.settings.collection_psa].url }}">PSA Guards</a>
            {% endif %}
            <a href="/#shop">Accessories</a>
          </div>
        </div>

        <div>
          <div style="font-size:12px; letter-spacing:0.1em; text-transform:uppercase; color:var(--vg-gold-400); margin-bottom:14px;">Explore</div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:14px; color:var(--vg-navy-300);">
            <a href="{{ section.settings.vault_link | default: '/pages/the-vault' }}">The Vault — Try It On</a>
            <a href="/#watch">Watch Once You Buy</a>
          </div>
        </div>

        <div>
          <div style="font-size:12px; letter-spacing:0.1em; text-transform:uppercase; color:var(--vg-gold-400); margin-bottom:14px;">Support</div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:14px; color:var(--vg-navy-300);">
            <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
            <a href="{{ pages.shipping.url | default: '#' }}">Shipping</a>
            <a href="{{ pages.faq.url | default: '#' }}">FAQ</a>
          </div>
        </div>
      </div>

      <div style="margin-top:48px; padding-top:24px; border-top:1px solid rgba(255,255,255,0.08); display:flex; flex-wrap:wrap; gap:8px 20px; justify-content:space-between; color:var(--vg-navy-400); font-size:13px;">
        <span>© {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Vaultguards' }}. All rights reserved.</span>
        <span>Not affiliated with TAG Grading or PSA.</span>
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "VG Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Precision-fit colorway guards for TAG and PSA graded slabs. Built for collectors who treat their cards like the assets they are."
    },
    {
      "type": "text",
      "id": "collection_tag",
      "label": "TAG collection handle",
      "info": "e.g. tag-guards-shimmer-series",
      "default": "tag-guards-shimmer-series"
    },
    {
      "type": "text",
      "id": "collection_psa",
      "label": "PSA collection handle",
      "info": "e.g. shimmer-series",
      "default": "shimmer-series"
    },
    {
      "type": "url",
      "id": "vault_link",
      "label": "The Vault link",
      "default": "/pages/the-vault"
    }
  ],
  "presets": [
    { "name": "VG Footer" }
  ]
}
{% endschema %}
