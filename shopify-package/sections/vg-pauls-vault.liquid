{% comment %}
  VAULTGUARDS - Paul's Vault Section
  A founder-showcase page. Paul can add / remove / reorder photos of his
  personal collection at any time through the theme editor - NO code edits
  ever needed for new photos.

  HOW TO ADD A NEW PHOTO (do this any time, as often as you want):
  1. Admin > Online Store > Themes > Customize.
  2. Top of screen, switch the page picker to "Pages" > "Paul's Vault".
  3. In the left panel, click into the "Paul's Vault" section.
  4. Click "Add block" > "Photo" > pick an image, optionally type a caption.
  5. Drag blocks to reorder, or click the trash icon on a block to remove it.
  6. Save.

  ONE-TIME SETUP (only needed once, already handled if this file was pushed
  by the assistant and a Page + template are set up per the assistant's
  instructions):
  - A Shopify Page titled "Paul's Vault" must exist (Online Store > Pages),
    with its Theme template set to "page.founder-collection" in the page
    editor's "Theme template" dropdown (labeled "Founder collection" in the
    dropdown list).
  - IMPORTANT: this is a DIFFERENT page from "The Vault" (the virtual try-on
    tool, template "page.vault" / labeled "Vault"). Do not set either page's
    Theme template to the other one's option - double-check the dropdown
    label on each page before saving:
      "The Vault" page        -> Theme template: "Vault"
      "Paul's Vault" page     -> Theme template: "Founder collection"
{% endcomment %}

<section class="vg-section vg-container" style="max-width:820px;">
  <div style="text-align:center; margin-bottom:36px;">
    <div class="vg-eyebrow" style="margin-bottom:10px;">{{ section.settings.eyebrow | default: "Founder's Collection" }}</div>
    <h1 style="margin-bottom:16px;">{{ section.settings.heading | default: "Paul's Vault" }}</h1>
    <div style="color:var(--vg-text-muted); font-size:15.5px; line-height:1.7; max-width:640px; margin:0 auto 28px;">
      {% if section.settings.intro != blank %}
        {{ section.settings.intro }}
      {% else %}
        <p>This page is dedicated to our founder's 1 collection. Vaultguards started from our founder's love for Pokemon, so this page shows the continuous changes of his current collection.</p>
        <p>Maybe this will inspire you to collect 1's?</p>
      {% endif %}
    </div>
    <a href="{{ section.settings.button_url | default: 'https://app.getcollectr.com/showcase/profile/1be0f82d-9d24-46a9-b41f-8702bf01f602' }}"
       target="_blank" rel="noopener"
       class="vg-btn vg-btn-gold" data-vg-haptic="tap">
      <i class="fa-solid fa-vault"></i> {{ section.settings.button_label | default: "Enter Paul's Vault" }}
    </a>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="pv-gallery-grid">
      {% for block in section.blocks %}
        {% if block.type == 'photo' %}
          <div class="pv-photo-card" {{ block.shopify_attributes }}>
            <div class="pv-photo-thumb">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 900 }}"
                     alt="{{ block.settings.caption | default: "Paul's collection photo" | escape }}"
                     loading="lazy" width="900" height="{{ 900.0 | divided_by: block.settings.image.aspect_ratio | round }}">
              {% else %}
                <div class="pv-photo-placeholder"><i class="fa-solid fa-image"></i></div>
              {% endif %}
            </div>
            {% if block.settings.caption != blank %}
              <div class="pv-photo-caption">{{ block.settings.caption }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="vg-card" style="padding:40px 24px; text-align:center; color:var(--vg-text-muted);">
      <i class="fa-solid fa-camera" style="font-size:26px; color:var(--vg-gold-500); margin-bottom:12px; display:block;"></i>
      Photos coming soon - check back as the collection grows.
    </div>
  {% endif %}
</section>

<style>
  .pv-gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .pv-photo-card { border-radius: var(--vg-radius-md); overflow: hidden; background: var(--vg-ivory-50); box-shadow: var(--vg-shadow-sm); }
  .pv-photo-thumb { position: relative; width: 100%; aspect-ratio: 1/1; background: var(--vg-ivory-100); }
  .pv-photo-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .pv-photo-placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--vg-navy-300); font-size: 22px; }
  .pv-photo-caption { font-size: 12.5px; color: var(--vg-navy-500); padding: 8px 10px; text-align: center; }
  @media (max-width: 720px) { .pv-gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
  @media (max-width: 420px) { .pv-gallery-grid { grid-template-columns: 1fr 1fr; gap: 10px; } }
</style>

{% schema %}
{
  "name": "Paul's Vault",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Founder's Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Paul's Vault"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>This page is dedicated to our founder's 1 collection. Vaultguards started from our founder's love for Pokemon, so this page shows the continuous changes of his current collection.</p><p>Maybe this will inspire you to collect 1's?</p>"
    },
    {
      "type": "header",
      "content": "External collection link (Collectr)"
    },
    {
      "type": "text",
      "id": "button_url",
      "label": "Button link (full URL)",
      "default": "https://app.getcollectr.com/showcase/profile/1be0f82d-9d24-46a9-b41f-8702bf01f602"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter Paul's Vault"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paul's Vault"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
