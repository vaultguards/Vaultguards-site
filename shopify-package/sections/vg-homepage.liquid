{% comment %}
  VAULTGUARDS - Homepage Section (for Online Store 2.0 themes where the
  homepage is built from index.json, not a plain index.liquid file)

  INSTALL:
  1. Edit code > Sections > Add a new section > name it "vg-homepage" >
     it creates sections/vg-homepage.liquid > select all > delete > paste
     this whole file in > Save.
  2. Go to Online Store > Themes > Customize (this opens the visual editor
     on your live homepage).
  3. Click "Add section" near the top or bottom of the page > find
     "Vaultguards Homepage" in the list > click it to add.
  4. (Recommended) Once it is added and looks right, you can remove/hide
     the theme original demo sections (hero banner, featured collection,
     etc.) above/below it so this is the only homepage content - click
     each one > the "..." menu > Remove, or click the eye icon to hide it.
  5. Click Save (top right of the Customize screen).

  Collection handles below default to your REAL live handles
  ("tag-guards-shimmer-series" and "shimmer-series"). If you ever rename
  those collections, just update the two handles in the CONFIG block below.
{% endcomment %}

{% comment %} ---- CONFIG: edit these two lines if your collection handles change ---- {% endcomment %}
{% assign tag_collection_handle = 'tag-guards-shimmer-series' %}
{% assign psa_collection_handle = 'shimmer-series' %}
{% assign tag_collection = collections[tag_collection_handle] %}
{% assign psa_collection = collections[psa_collection_handle] %}

{% comment %} Pick the Aura product for the spotlight section (falls back gracefully if not found) {% endcomment %}
{% assign aura = all_products['aura'] %}

<section style="position:relative; padding:110px 0 90px; overflow:hidden;">
  <div class="vg-container vg-grid-2">
    <div class="vg-reveal vg-in">
      <h1 style="font-size:56px; line-height:1.05; margin:0 0 22px; display:flex; align-items:center; flex-wrap:wrap; gap:16px;">
        <span>Welcome to</span>
        <img src="{{ 'vaultguards-wordmark-dark.png' | asset_url }}" alt="Vaultguards" class="vg-hero-wordmark" width="615" height="48">
      </h1>
      <p style="font-size:18px; color:var(--vg-navy-400); max-width:440px; margin-bottom:34px;">
        Precision fit guards with acrylic backing, made specifically for TAG and PSA slabs.
      </p>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <a href="#shop" class="vg-btn vg-btn-primary" data-vg-haptic="tap">Shop Guards <i class="fa-solid fa-arrow-right"></i></a>
        <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}" class="vg-btn vg-btn-ghost" data-vg-haptic="tap"><i class="fa-solid fa-vault"></i> Try It On in The Vault</a>
      </div>
      <a href="#watch" class="vg-hero-video-link" data-vg-haptic="tap">
        <i class="fa-solid fa-circle-play"></i> Click to see how Vaultguards stands out
      </a>
      <div style="display:flex; gap:28px; margin-top:44px; flex-wrap:wrap;">
        <div style="max-width:170px;"><div style="font-family:var(--vg-font-display); font-size:20px; color:var(--vg-gold-500);"><i class="fa-solid fa-bullseye"></i></div><div style="font-size:12px; color:var(--vg-navy-400); margin-top:6px;">Precision fit for 2 brands: TAG and PSA slabs</div></div>
      </div>
    </div>
    <div class="vg-reveal" data-delay="1">
      <div class="vg-card" style="padding:28px; border-radius:var(--vg-radius-xl);">
        <div id="vg-hero-rotator" style="position:relative; aspect-ratio:4/5; border-radius:26px; overflow:hidden; background:var(--vg-ivory-200);">
          {% comment %}
            By default this rotates real photos pulled straight from your TAG
            and PSA products, so it always matches current inventory with no
            setup. If you want full manual control instead, open Theme
            Customize > this section's settings and upload photos into "Hero
            photo 1-4": as soon as one is uploaded, it replaces the automatic
            product photos below.
          {% endcomment %}
          {% assign vg_hero_shown = 0 %}
          {% assign vg_hero_keys = 'hero_photo_1,hero_photo_2,hero_photo_3,hero_photo_4' | split: ',' %}
          {% for vg_key in vg_hero_keys %}
            {% assign vg_hero_img = section.settings[vg_key] %}
            {% if vg_hero_img %}
              <img src="{{ vg_hero_img | image_url: width: 900 }}" alt="Vaultguards colorway guard" class="vg-hero-slide{% if vg_hero_shown == 0 %} vg-hero-slide-active{% endif %}" width="900" height="1125">
              {% assign vg_hero_shown = vg_hero_shown | plus: 1 %}
            {% endif %}
          {% endfor %}
          {% if vg_hero_shown == 0 %}
            {% for product in tag_collection.products limit: 4 %}
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | default: 'Vaultguards colorway guard' }}" class="vg-hero-slide{% if vg_hero_shown == 0 %} vg-hero-slide-active{% endif %}" width="900" height="1125">
                {% assign vg_hero_shown = vg_hero_shown | plus: 1 %}
              {% endif %}
            {% endfor %}
            {% for product in psa_collection.products limit: 4 %}
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | default: 'Vaultguards colorway guard' }}" class="vg-hero-slide{% if vg_hero_shown == 0 %} vg-hero-slide-active{% endif %}" width="900" height="1125">
                {% assign vg_hero_shown = vg_hero_shown | plus: 1 %}
              {% endif %}
            {% endfor %}
            {% if vg_hero_shown == 0 and tag_collection and tag_collection.image %}
              <img src="{{ tag_collection.image | image_url: width: 900 }}" alt="Vaultguards colorway guard" class="vg-hero-slide vg-hero-slide-active" width="900" height="1125">
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<section id="shop" class="vg-section" style="background:var(--vg-bg-alt); padding-top:56px;">
  <div class="vg-container">
    <div class="vg-reveal" style="text-align:center; max-width:600px; margin:0 auto 50px;">
      <div class="vg-eyebrow">The Collection</div>
      <h2 style="font-size:38px; margin-top:14px;">Shop by brand fit.</h2>
    </div>

    {% if tag_collection %}
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
        <img src="{{ 'tag-logo.png' | asset_url }}" alt="TAG" width="76" height="28" style="height:22px; width:auto; display:block;">
        <a href="{{ tag_collection.url }}" class="vg-pill vg-pill-gold" style="text-decoration:none;">Shop TAG Collection <i class="fa-solid fa-arrow-right" style="font-size:10px; margin-left:2px;"></i></a>
      </div>
      <div class="vg-grid-4" style="margin-bottom:56px;">
        {% for product in tag_collection.products limit: 4 %}
          <a href="{{ product.url }}" class="vg-card vg-product-card vg-reveal" data-delay="{{ forloop.index0 | modulo: 4 }}">
            <div class="vg-product-card-img">
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title }}" loading="lazy" width="700" height="875">
            </div>
            <div class="vg-product-card-body">
              <div style="font-weight:600; font-size:15px; margin-bottom:6px;">{{ product.title }}</div>
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="color:var(--vg-navy-600);">{{ product.price | money }}</span>
                <span class="{% if product.available %}vg-pill vg-pill-in{% else %}vg-pill vg-pill-out{% endif %}">
                  {% if product.available %}In stock{% else %}Out of stock{% endif %}
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if psa_collection %}
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
        <img src="{{ 'psa-logo.png' | asset_url }}" alt="PSA" width="70" height="28" style="height:22px; width:auto; display:block;">
        <a href="{{ psa_collection.url }}" class="vg-pill vg-pill-gold" style="text-decoration:none;">Shop PSA Collection <i class="fa-solid fa-arrow-right" style="font-size:10px; margin-left:2px;"></i></a>
      </div>
      <div class="vg-grid-4">
        {% for product in psa_collection.products limit: 4 %}
          <a href="{{ product.url }}" class="vg-card vg-product-card vg-reveal" data-delay="{{ forloop.index0 | modulo: 4 }}">
            <div class="vg-product-card-img">
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title }}" loading="lazy" width="700" height="875">
            </div>
            <div class="vg-product-card-body">
              <div style="font-weight:600; font-size:15px; margin-bottom:6px;">{{ product.title }}</div>
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="color:var(--vg-navy-600);">{{ product.price | money }}</span>
                <span class="{% if product.available %}vg-pill vg-pill-in{% else %}vg-pill vg-pill-out{% endif %}">
                  {% if product.available %}In stock{% else %}Out of stock{% endif %}
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <div style="text-align:center; margin-top:48px;">
      <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}" class="vg-btn vg-btn-gold" data-vg-haptic="tap"><i class="fa-solid fa-vault"></i> Preview Your Slab in The Vault</a>
    </div>
  </div>
</section>

{% comment %}
  The spotlight photo defaults to the Aura product's real photo. To swap it
  without touching the product, open Theme Customize > this section's
  settings and upload a photo into "Spotlight photo override".
{% endcomment %}
{% assign vg_spotlight_img = section.settings.spotlight_photo %}
{% unless vg_spotlight_img %}{% assign vg_spotlight_img = aura.featured_image %}{% endunless %}
{% if aura %}
