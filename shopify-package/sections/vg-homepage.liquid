<style>
  .vg-hero-slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1100ms var(--vg-ease-soft); }
  .vg-hero-slide-active { opacity: 1; }
  .vg-features-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  @media (max-width: 1024px) { .vg-features-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 720px) { .vg-features-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
  @media (max-width: 480px) { .vg-features-grid { grid-template-columns: 1fr; } }
  .vg-hero-wordmark { height: 48px; width: auto; display: block; }
  @media (max-width: 640px) { .vg-hero-wordmark { height: 34px; } }
  html { scroll-behavior: smooth; }
  .vg-hero-video-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; padding: 10px 18px; border-radius: var(--vg-radius-pill); background: var(--vg-gold-050); color: var(--vg-gold-500); font-size: 13px; font-weight: 600; text-decoration: none; box-shadow: var(--vg-shadow-sm); transition: box-shadow var(--vg-dur-fast) var(--vg-ease-soft), transform var(--vg-dur-fast) var(--vg-ease-soft); }
  .vg-hero-video-link i { font-size: 15px; }
  .vg-hero-video-link:hover { box-shadow: var(--vg-shadow-md); transform: translateY(-1px); }
  .vg-hero-video-link:active { transform: scale(.97); }
</style>

<script>
(function () {
  function vgInitHeroRotator() {
    var rotator = document.getElementById('vg-hero-rotator');
    if (!rotator) return;
    var slides = rotator.querySelectorAll('.vg-hero-slide');
    if (slides.length < 2) return;
    var idx = 0;
    Array.prototype.forEach.call(slides, function (s, i) { if (i > 0) s.classList.remove('vg-hero-slide-active'); });
    setInterval(function () {
      slides[idx].classList.remove('vg-hero-slide-active');
      idx = (idx + 1) % slides.length;
      slides[idx].classList.add('vg-hero-slide-active');
    }, 3200);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', vgInitHeroRotator);
  } else {
    vgInitHeroRotator();
  }
})();
</script>

{% schema %}
{
  "name": "Vaultguards Homepage",
  "settings": [
    {
      "type": "header",
      "content": "Hero photo rotator (optional)"
    },
    {
      "type": "paragraph",
      "content": "Leave these empty to keep automatically rotating real photos from your TAG and PSA products (default, always matches your inventory). Upload your own photos here instead if you want full manual control over what shows in the big rotating photo next to \"A perfect fit, every angle.\""
    },
    {
      "type": "image_picker",
      "id": "hero_photo_1",
      "label": "Hero photo 1"
    },
    {
      "type": "image_picker",
      "id": "hero_photo_2",
      "label": "Hero photo 2"
    },
    {
      "type": "image_picker",
      "id": "hero_photo_3",
      "label": "Hero photo 3"
    },
    {
      "type": "image_picker",
      "id": "hero_photo_4",
      "label": "Hero photo 4"
    },
    {
      "type": "header",
      "content": "Spotlight colorway photo (optional)"
    },
    {
      "type": "paragraph",
      "content": "Leave empty to automatically use the Aura product's real photo (default)."
    },
    {
      "type": "image_picker",
      "id": "spotlight_photo",
      "label": "Spotlight photo override"
    }
  ],
  "presets": [
    {
      "name": "Vaultguards Homepage"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
