{% comment %}
  VAULTGUARDS - Homepage Section (for Online Store 2.0 themes where the
  homepage is built from index.json, not a plain index.liquid file)

  INSTALL:
  1. Edit code > Sections > Add a new section > name it "vg-homepage" >
     it creates sections/vg-homepage.liquid > select all > delete > paste
     this whole file in > Save.
  2. Go to Online Store > Themes > Customize (this opens the visual editor
     on your live homepage).
  3. Click "Add section" near the top or bottom of the page > find
     "Vaultguards Homepage" in the list > click it to add.
  4. (Recommended) Once it is added and looks right, you can remove/hide
     the theme original demo sections (hero banner, featured collection,
     etc.) above/below it so this is the only homepage content - click
     each one > the "..." menu > Remove, or click the eye icon to hide it.
  5. Click Save (top right of the Customize screen).

  Collection handles below default to your REAL live handles
  ("tag-guards-shimmer-series" and "shimmer-series"). If you ever rename
  those collections, just update the two handles in the CONFIG block below.
{% endcomment %}

{% comment %} ---- CONFIG: edit these two lines if your collection handles change ---- {% endcomment %}
{% assign tag_collection_handle = 'tag-guards-shimmer-series' %}
{% assign psa_collection_handle = 'shimmer-series' %}
{% assign tag_collection = collections[tag_collection_handle] %}
{% assign psa_collection = collections[psa_collection_handle] %}

{% comment %} Pick the Aura product for the spotlight section (falls back gracefully if not found) {% endcomment %}
{% assign aura = all_products['aura'] %}

<section style="position:relative; padding:110px 0 90px; overflow:hidden;">
  <div class="vg-container vg-grid-2">
    <div class="vg-reveal vg-in">
      <div class="vg-eyebrow">Built for graded slabs</div>
      <h1 style="font-size:56px; line-height:1.05; margin:18px 0 22px;">
        A perfect fit,<br><em style="color:var(--vg-gold-500); font-style:normal;">every angle.</em>
      </h1>
      <p style="font-size:18px; color:var(--vg-navy-400); max-width:440px; margin-bottom:34px;">
        Precision-molded colorway guards for TAG and PSA slabs &mdash; engineered edge protection
        that never covers the label you paid to see.
      </p>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <a href="#shop" class="vg-btn vg-btn-primary" data-vg-haptic="tap">Shop Guards <i class="fa-solid fa-arrow-right"></i></a>
        <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}" class="vg-btn vg-btn-ghost" data-vg-haptic="tap"><i class="fa-solid fa-vault"></i> Try It On in The Vault</a>
      </div>
      <div style="display:flex; gap:28px; margin-top:44px; flex-wrap:wrap;">
        <div><div style="font-family:var(--vg-font-display); font-size:26px;">29+</div><div style="font-size:12px; color:var(--vg-navy-400);">Colorways</div></div>
        <div><div style="font-family:var(--vg-font-display); font-size:26px;">2</div><div style="font-size:12px; color:var(--vg-navy-400);">Brand fits &mdash; TAG &amp; PSA</div></div>
        <div><div style="font-family:var(--vg-font-display); font-size:26px;">100%</div><div style="font-size:12px; color:var(--vg-navy-400);">Label visibility</div></div>
      </div>
    </div>
    <div class="vg-reveal" data-delay="1">
      <div class="vg-card" style="padding:28px; border-radius:var(--vg-radius-xl);">
        <div style="aspect-ratio:4/5; border-radius:26px; overflow:hidden;">
          {% if tag_collection and tag_collection.image %}
            <img src="{{ tag_collection.image | image_url: width: 900 }}" alt="Vaultguards colorway guard" style="width:100%; height:100%; object-fit:cover;" width="900" height="1125">
          {% elsif tag_collection.products.first %}
            <img src="{{ tag_collection.products.first.featured_image | image_url: width: 900 }}" alt="Vaultguards colorway guard" style="width:100%; height:100%; object-fit:cover;" width="900" height="1125">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<section id="shop" class="vg-section" style="background:var(--vg-bg-alt); padding-top:56px;">
  <div class="vg-container">
    <div class="vg-reveal" style="text-align:center; max-width:600px; margin:0 auto 50px;">
      <div class="vg-eyebrow">The Collection</div>
      <h2 style="font-size:38px; margin-top:14px;">Shop by brand fit.</h2>
    </div>

    {% if tag_collection %}
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
        <h3 style="font-size:20px;">TAG Guards</h3>
        <a href="{{ tag_collection.url }}" class="vg-pill vg-pill-gold" style="text-decoration:none;">Shop TAG Collection <i class="fa-solid fa-arrow-right" style="font-size:10px; margin-left:2px;"></i></a>
      </div>
      <div class="vg-grid-4" style="margin-bottom:56px;">
        {% for product in tag_collection.products limit: 4 %}
          <a href="{{ product.url }}" class="vg-card vg-product-card vg-reveal" data-delay="{{ forloop.index0 | modulo: 4 }}">
            <div class="vg-product-card-img">
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title }}" loading="lazy" width="700" height="875">
            </div>
            <div class="vg-product-card-body">
              <div style="font-weight:600; font-size:15px; margin-bottom:6px;">{{ product.title }}</div>
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="color:var(--vg-navy-600);">{{ product.price | money }}</span>
                <span class="{% if product.available %}vg-pill vg-pill-in{% else %}vg-pill vg-pill-out{% endif %}">
                  {% if product.available %}In stock{% else %}Out of stock{% endif %}
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if psa_collection %}
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
        <h3 style="font-size:20px;">PSA Guards</h3>
        <a href="{{ psa_collection.url }}" class="vg-pill vg-pill-gold" style="text-decoration:none;">Shop PSA Collection <i class="fa-solid fa-arrow-right" style="font-size:10px; margin-left:2px;"></i></a>
      </div>
      <div class="vg-grid-4">
        {% for product in psa_collection.products limit: 4 %}
          <a href="{{ product.url }}" class="vg-card vg-product-card vg-reveal" data-delay="{{ forloop.index0 | modulo: 4 }}">
            <div class="vg-product-card-img">
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title }}" loading="lazy" width="700" height="875">
            </div>
            <div class="vg-product-card-body">
              <div style="font-weight:600; font-size:15px; margin-bottom:6px;">{{ product.title }}</div>
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="color:var(--vg-navy-600);">{{ product.price | money }}</span>
                <span class="{% if product.available %}vg-pill vg-pill-in{% else %}vg-pill vg-pill-out{% endif %}">
                  {% if product.available %}In stock{% else %}Out of stock{% endif %}
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <div style="text-align:center; margin-top:48px;">
      <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}" class="vg-btn vg-btn-gold" data-vg-haptic="tap"><i class="fa-solid fa-vault"></i> Preview Your Slab in The Vault</a>
    </div>
  </div>
</section>

{% if aura %}
<section class="vg-section" style="background:var(--vg-navy-900); overflow:hidden;">
  <div class="vg-container vg-grid-2">
    <div class="vg-reveal vg-in">
      <div class="vg-card" style="padding:26px; background:var(--vg-navy-800); box-shadow:none;">
        <div style="aspect-ratio:4/5; border-radius:var(--vg-radius-md); overflow:hidden; background:var(--vg-navy-700);">
          <img src="{{ aura.featured_image | image_url: width: 900 }}" alt="{{ aura.title }}" style="width:100%; height:100%; object-fit:cover;" loading="lazy" width="900" height="1125">
        </div>
      </div>
    </div>
    <div class="vg-reveal" data-delay="1">
      <div class="vg-eyebrow" style="color:var(--vg-gold-400);">Spotlight colorway</div>
      <h2 style="font-size:36px; margin:16px 0 16px; color:#fff;">Meet <em style="color:var(--vg-gold-400); font-style:normal;">Aura</em>.</h2>
      <p style="color:var(--vg-navy-300); font-size:16px; line-height:1.7; max-width:440px; margin-bottom:16px;">
        Completely clear. No tint, no finish, nothing between you and the slab. Aura is built for the
        purist collector who doesn&rsquo;t want to take anything away from the clean look of a TAG slab &mdash;
        full edge and corner protection, plus the same solid acrylic backing as every other colorway,
        without changing how the card looks in your hand.
      </p>
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:28px;">
        <span style="font-size:19px; color:#fff; font-weight:600;">{{ aura.price | money }}</span>
        <span class="{% if aura.available %}vg-pill vg-pill-in{% else %}vg-pill vg-pill-out{% endif %}">
          {% if aura.available %}In stock{% else %}Out of stock{% endif %}
        </span>
      </div>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <a href="{{ aura.url }}" class="vg-btn vg-btn-gold" data-vg-haptic="tap">Shop Aura <i class="fa-solid fa-arrow-right"></i></a>
        <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}" class="vg-btn vg-btn-ghost" data-vg-haptic="tap"><i class="fa-solid fa-vault"></i> Try It On</a>
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="vg-section">
  <div class="vg-container">
    <div class="vg-reveal" style="text-align:center; max-width:640px; margin:0 auto 64px;">
      <div class="vg-eyebrow">Why collectors switch</div>
      <h2 style="font-size:38px; margin-top:14px;">Protection that respects the grade.</h2>
    </div>
    <div class="vg-grid-4">
      <div class="vg-reveal vg-card" data-delay="0" style="padding:30px;">
        <div style="width:48px; height:48px; border-radius:14px; background:var(--vg-gold-050); display:flex; align-items:center; justify-content:center; color:var(--vg-gold-500); font-size:18px; margin-bottom:16px;"><i class="fa-solid fa-shield-halved"></i></div>
        <h3 style="font-size:17px; margin-bottom:9px;">Edge-first armor</h3>
        <p style="color:var(--vg-navy-400); font-size:14px; margin:0;">Guards wrap the slab&rsquo;s edges and corners only &mdash; the label, cert number, and card stay fully visible.</p>
      </div>
      <div class="vg-reveal vg-card" data-delay="1" style="padding:30px;">
        <div style="width:48px; height:48px; border-radius:14px; background:var(--vg-gold-050); display:flex; align-items:center; justify-content:center; color:var(--vg-gold-500); font-size:18px; margin-bottom:16px;"><i class="fa-solid fa-layer-group"></i></div>
        <h3 style="font-size:17px; margin-bottom:9px;">Solid acrylic backing</h3>
        <p style="color:var(--vg-navy-400); font-size:14px; margin:0;">Every guard ships with a clear acrylic back panel, not a soft bumper &mdash; full rear protection for your slab.</p>
      </div>
      <div class="vg-reveal vg-card" data-delay="2" style="padding:30px;">
        <div style="width:48px; height:48px; border-radius:14px; background:var(--vg-gold-050); display:flex; align-items:center; justify-content:center; color:var(--vg-gold-500); font-size:18px; margin-bottom:16px;"><i class="fa-solid fa-palette"></i></div>
        <h3 style="font-size:17px; margin-bottom:9px;">29 real colorways</h3>
        <p style="color:var(--vg-navy-400); font-size:14px; margin:0;">From Aura white to Curse purple-black &mdash; every finish is photographed on real slabs, not renders.</p>
      </div>
      <div class="vg-reveal vg-card" data-delay="3" style="padding:30px;">
        <div style="width:48px; height:48px; border-radius:14px; background:var(--vg-gold-050); display:flex; align-items:center; justify-content:center; color:var(--vg-gold-500); font-size:18px; margin-bottom:16px;"><i class="fa-solid fa-vault"></i></div>
        <h3 style="font-size:17px; margin-bottom:9px;">Try before you buy</h3>
        <p style="color:var(--vg-navy-400); font-size:14px; margin:0;">Upload your own slab in The Vault and preview it inside any guard color before it ships.</p>
      </div>
    </div>
  </div>
</section>

{% comment %} ---- Suggested for you: pull a few more products from the same collections, real Shopify data, no manual setup ---- {% endcomment %}
<section class="vg-section" style="background:var(--vg-bg-alt);">
  <div class="vg-container">
    <div class="vg-reveal" style="text-align:center; max-width:600px; margin:0 auto 50px;">
      <div class="vg-eyebrow">Complete the set</div>
      <h2 style="font-size:38px; margin-top:14px;">Suggested for you.</h2>
      <p style="color:var(--vg-navy-400); margin-top:12px;">A few more colorways collectors are pairing together.</p>
    </div>
    <div class="vg-grid-4">
      {% for product in tag_collection.products offset: 4 limit: 2 %}
        <a href="{{ product.url }}" class="vg-card vg-product-card vg-reveal">
          <div class="vg-product-card-img"><img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title }}" loading="lazy" width="700" height="875"></div>
          <div class="vg-product-card-body">
            <div style="font-weight:600; font-size:15px; margin-bottom:6px;">{{ product.title }}</div>
            <span style="color:var(--vg-navy-600);">{{ product.price | money }}</span>
          </div>
        </a>
      {% endfor %}
      {% for product in psa_collection.products offset: 4 limit: 2 %}
        <a href="{{ product.url }}" class="vg-card vg-product-card vg-reveal">
          <div class="vg-product-card-img"><img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title }}" loading="lazy" width="700" height="875"></div>
          <div class="vg-product-card-body">
            <div style="font-weight:600; font-size:15px; margin-bottom:6px;">{{ product.title }}</div>
            <span style="color:var(--vg-navy-600);">{{ product.price | money }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% comment %} ---- Watch Once You Buy: swap YOUTUBE_ID for your real unboxing video ---- {% endcomment %}
{% assign youtube_id = 'dQw4w9WgXcQ' %}
<section id="watch" class="vg-section" style="background:var(--vg-navy-900);">
  <div class="vg-container">
    <div class="vg-reveal" style="text-align:center; max-width:600px; margin:0 auto 40px;">
      <div class="vg-eyebrow" style="color:var(--vg-gold-400);">How it opens</div>
      <h2 style="font-size:36px; margin-top:14px; color:#fff;">Watch once you buy.</h2>
      <p style="color:var(--vg-navy-300); margin-top:12px; font-size:15.5px;">
        A quick look at Vaultguards&rsquo; unique pull-tab unboxing &mdash; two pulls, press the perforated edge, and your guard is ready.
      </p>
    </div>
    <div class="vg-reveal" style="max-width:900px; margin:0 auto;">
      <div class="vg-video-frame">
        <iframe src="https://www.youtube-nocookie.com/embed/{{ youtube_id }}" title="How to open your Vaultguards guard" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>

<section class="vg-section" style="text-align:center;">
  <div class="vg-container vg-reveal" style="max-width:640px;">
    <h2 style="font-size:36px; margin-bottom:16px;">See your slab in every color first.</h2>
    <p style="color:var(--vg-navy-400); margin-bottom:30px;">No commitment. Upload a photo, try every colorway, then decide.</p>
    <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}" class="vg-btn vg-btn-primary" data-vg-haptic="tap" style="padding:18px 40px; font-size:16px;">
      Enter The Vault <i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Vaultguards Homepage",
  "settings": [],
  "presets": [
    {
      "name": "Vaultguards Homepage"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
