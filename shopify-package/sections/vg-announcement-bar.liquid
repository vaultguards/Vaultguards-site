{% comment %}
  VAULTGUARDS — Announcement Bar
  INSTALL: Online Store > Themes > Edit code > Sections > Add a new section
  > name it "vg-announcement-bar" > paste this whole file in > Save.
  Then: Online Store > Themes > Customize > click "Add section" at the very
  top of the page (above the header) > choose "VG Announcement Bar".
  Do this once and it will show on every page automatically (if you add it
  to a page-specific template, it will only show there — adding it at the
  top of the theme's default template, or in the header group, makes it
  sitewide).
{% endcomment %}

<link rel="stylesheet" href="{{ 'vg-theme.css' | asset_url }}">

<div class="vg-root">
  <div class="vg-announce">
    <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
    {{ section.settings.message }}
  </div>
</div>

{% schema %}
{
  "name": "VG Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Free US Shipping On Orders Over $50."
    }
  ],
  "presets": [
    { "name": "VG Announcement Bar" }
  ]
}
{% endschema %}
