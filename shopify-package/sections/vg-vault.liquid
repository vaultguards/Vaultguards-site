{% comment %}
  VAULTGUARDS - The Vault Section (virtual try-on), connected to real
  products. Fully client-side: no server, no data storage. A visitor uploads
  a photo of their slab (it stays only in their own browser tab - nothing is
  sent anywhere or saved), picks a real product from your TAG or PSA
  collection, and previews a guard-color frame around their photo - the tint
  is sampled live from that real product photo, so it is not a
  fake/placeholder color. From there they can jump to that product page or
  add it straight to cart.

  CONFIG: edit the two handles below if your collection handles ever change.

  This theme only exposes a JSON view for page templates (no plain Liquid
  template file to paste into), so this ships as a SECTION instead. Sections
  are added on top of the page through the theme editor.

  INSTALL:
  1. Admin > Online Store > Themes > Edit code.
  2. In the left sidebar, find "Sections" > click the plus icon next to it >
     name the new file "vg-vault" (it will be saved as
     sections/vg-vault.liquid) > select all the placeholder text > delete >
     paste this whole file in > Save.
  3. Online Store > Pages > Add page. Title it "The Vault". Set the URL
     handle to exactly "the-vault" (every other file already links to
     /pages/the-vault - matching this handle means zero other edits anywhere
     else on the site). Save.
  4. Go to Online Store > Themes > Customize.
  5. At the very top of the Customize screen there is a page picker
     dropdown. Switch it to "Pages" > choose the "The Vault" page you just
     created.
  6. In the left panel, scroll to the bottom of the section list and click
     "Add section" > find "Vaultguards Vault" > click it to add it.
  7. Remove or hide any other sections already on this page template so only
     Vaultguards Vault shows.
  8. Click Save in the top right.
  9. Open your storefront > click "Try It On" in the nav, or visit
     /pages/the-vault directly > upload a photo, pick a product, try
     Add to Cart.
{% endcomment %}

{% assign tag_collection_handle = 'tag-guards-shimmer-series' %}
{% assign psa_collection_handle = 'shimmer-series' %}
{% assign tag_collection = collections[tag_collection_handle] %}
{% assign psa_collection = collections[psa_collection_handle] %}

<section class="vg-section" style="padding-top:56px;">
  <div class="vg-container" style="max-width:900px;">
    <div class="vg-reveal vg-in" style="text-align:center; margin-bottom:40px;">
      <div class="vg-eyebrow">Virtual Try-On</div>
      <h1 style="font-size:40px; margin-top:14px;">Welcome to The Vault.</h1>
      <p style="color:var(--vg-navy-400); margin-top:12px; font-size:16px;">
        Upload a photo of your slab, pick a real colorway from the shop, and preview it
        before you buy. Your photo stays in your browser only - nothing is uploaded or
        saved anywhere.
      </p>
    </div>

    <div class="vg-card vg-reveal" style="padding:28px;">
      <div style="display:flex; gap:10px; justify-content:center; margin-bottom:26px;">
        <button type="button" class="vg-fb-btn vg-fb-active" id="vg-vault-tag-btn">TAG Slab</button>
        <button type="button" class="vg-fb-btn" id="vg-vault-psa-btn">PSA Slab</button>
      </div>

      <div class="vg-grid-2" style="gap:36px; align-items:start;">
        <div>
          <div id="vg-vault-frame" style="position:relative; max-width:340px; margin:0 auto 18px; aspect-ratio:0.72; border-radius:18px; padding:16px; background:#D8DEE3; transition:background 260ms var(--vg-ease-soft), aspect-ratio 220ms var(--vg-ease-soft);">
            <div style="width:100%; height:100%; border-radius:8px; background:#fff; overflow:hidden; display:flex; align-items:center; justify-content:center;">
              <img id="vg-vault-photo" src="" alt="Your uploaded slab" style="display:none; width:100%; height:100%; object-fit:contain;" width="340" height="472">
              <div id="vg-vault-placeholder" style="text-align:center; color:var(--vg-navy-400); font-size:13px; padding:20px;">
                <i class="fa-solid fa-image" style="font-size:26px; display:block; margin-bottom:10px;"></i>
                Upload a photo to preview
              </div>
            </div>
          </div>

          <div style="text-align:center; margin-bottom:8px;">
            <label for="vg-vault-upload" class="vg-btn vg-btn-primary" data-vg-haptic="tap" style="cursor:pointer;">
              <i class="fa-solid fa-upload"></i> Upload Your Slab Photo
            </label>
            <input type="file" id="vg-vault-upload" accept="image/*" style="display:none;">
          </div>
          <p style="text-align:center; font-size:12px; color:var(--vg-navy-400);">
            Tint above is sampled live from the selected product photo on the right.
          </p>
        </div>

        <div>
          <div id="vg-vault-selected" style="display:none; margin-bottom:16px;">
            <div class="vg-card-flat" style="padding:14px 16px; display:flex; align-items:center; gap:12px;">
              <img id="vg-vault-selected-img" src="" alt="" style="width:44px; height:55px; border-radius:8px; object-fit:cover; flex-shrink:0;" width="44" height="55">
              <div style="flex:1; min-width:0;">
                <div id="vg-vault-selected-title" style="font-weight:600; font-size:14px;"></div>
                <div id="vg-vault-selected-price" style="font-size:13px; color:var(--vg-navy-400);"></div>
              </div>
            </div>
            <div style="display:flex; gap:10px; margin-top:12px;">
              <a id="vg-vault-shop-link" href="#" class="vg-btn vg-btn-ghost" data-vg-haptic="tap" style="flex:1; font-size:13px; padding:12px;">
                <i class="fa-solid fa-eye"></i> View Product
              </a>
              <button type="button" id="vg-vault-add-cart" class="vg-btn vg-btn-gold" data-vg-haptic="tap" style="flex:1; font-size:13px; padding:12px;">
                <i class="fa-solid fa-bag-shopping"></i> Add to Cart
              </button>
            </div>
            <div id="vg-vault-cart-msg" style="text-align:center; font-size:12px; color:var(--vg-success); margin-top:8px; display:none;">
              Added to cart.
            </div>
          </div>

          <div style="margin-bottom:8px; font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:var(--vg-navy-400);">
            Pick a colorway
          </div>
          <div id="vg-vault-swatches" style="display:grid; grid-template-columns:repeat(5,1fr); gap:10px;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% comment %} ---- Build real product data as JSON, safely escaped by the json filter ---- {% endcomment %}
{% capture tag_products_json %}[
  {% for product in tag_collection.products %}
    {
      "id": {{ product.selected_or_first_available_variant.id | default: 0 }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "priceCents": {{ product.price }},
      "available": {{ product.available }},
      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 200 | json }}{% else %}""{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]{% endcapture %}

{% capture psa_products_json %}[
  {% for product in psa_collection.products %}
    {
      "id": {{ product.selected_or_first_available_variant.id | default: 0 }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "priceCents": {{ product.price }},
      "available": {{ product.available }},
      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 200 | json }}{% else %}""{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]{% endcapture %}

<script>
(function () {
  var VG_VAULT_PRODUCTS = {
    tag: {{ tag_products_json }},
    psa: {{ psa_products_json }}
  };

  var frame = document.getElementById('vg-vault-frame');
  var swatchRow = document.getElementById('vg-vault-swatches');
  var photo = document.getElementById('vg-vault-photo');
  var placeholder = document.getElementById('vg-vault-placeholder');
  var upload = document.getElementById('vg-vault-upload');
  var tagBtn = document.getElementById('vg-vault-tag-btn');
  var psaBtn = document.getElementById('vg-vault-psa-btn');
  var selectedBox = document.getElementById('vg-vault-selected');
  var selectedImg = document.getElementById('vg-vault-selected-img');
  var selectedTitle = document.getElementById('vg-vault-selected-title');
  var selectedPrice = document.getElementById('vg-vault-selected-price');
  var shopLink = document.getElementById('vg-vault-shop-link');
  var addCartBtn = document.getElementById('vg-vault-add-cart');
  var cartMsg = document.getElementById('vg-vault-cart-msg');

  var currentBrand = 'tag';
  var currentProduct = null;

  function formatPrice(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function setFrameColor(hex) {
    if (frame) frame.style.background = hex;
  }

  function sampleColorFromImage(url, callback) {
    var img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = function () {
      try {
        var canvas = document.createElement('canvas');
        canvas.width = 12;
        canvas.height = 12;
        var ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, 12, 12);
        var data = ctx.getImageData(0, 0, 12, 12).data;
        var r = 0, g = 0, b = 0, count = 0;
        for (var i = 0; i < data.length; i += 4) {
          r += data[i];
          g += data[i + 1];
          b += data[i + 2];
          count++;
        }
        r = Math.round(r / count);
        g = Math.round(g / count);
        b = Math.round(b / count);
        callback('rgb(' + r + ',' + g + ',' + b + ')');
      } catch (err) {
        callback('#D8DEE3');
      }
    };
    img.onerror = function () {
      callback('#D8DEE3');
    };
    img.src = url;
  }

  function selectProduct(p) {
    currentProduct = p;
    sampleColorFromImage(p.image, setFrameColor);
    if (selectedBox) selectedBox.style.display = 'block';
    if (selectedImg) selectedImg.src = p.image;
    if (selectedTitle) selectedTitle.textContent = p.title;
    if (selectedPrice) selectedPrice.textContent = formatPrice(p.priceCents) + (p.available ? '' : ' - Out of stock');
    if (shopLink) shopLink.href = p.url;
    if (addCartBtn) addCartBtn.disabled = !p.available;
    if (cartMsg) cartMsg.style.display = 'none';
    Array.prototype.forEach.call(swatchRow.children, function (el) {
      el.style.boxShadow = 'var(--vg-shadow-xs)';
      el.style.outline = 'none';
    });
  }

  function renderSwatches(brand) {
    currentBrand = brand;
    swatchRow.innerHTML = '';
    var list = VG_VAULT_PRODUCTS[brand] || [];
    list.forEach(function (p, i) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.title = p.title;
      btn.setAttribute('aria-label', p.title);
      btn.style.padding = '0';
      btn.style.border = 'none';
      btn.style.borderRadius = '10px';
      btn.style.overflow = 'hidden';
      btn.style.cursor = 'pointer';
      btn.style.aspectRatio = '4/5';
      btn.style.boxShadow = 'var(--vg-shadow-xs)';
      var img = document.createElement('img');
      img.src = p.image;
      img.alt = p.title;
      img.style.width = '100%';
      img.style.height = '100%';
      img.style.objectFit = 'cover';
      img.style.display = 'block';
      btn.appendChild(img);
      btn.addEventListener('click', function () {
        selectProduct(p);
        btn.style.outline = '3px solid var(--vg-navy-900)';
      });
      swatchRow.appendChild(btn);
      if (i === 0) selectProduct(p);
    });
    if (!list.length && selectedBox) {
      selectedBox.style.display = 'none';
      setFrameColor('#D8DEE3');
    }
  }

  function setBrand(brand) {
    if (frame) frame.style.aspectRatio = brand === 'psa' ? '0.78' : '0.72';
    if (tagBtn) tagBtn.classList.toggle('vg-fb-active', brand === 'tag');
    if (psaBtn) psaBtn.classList.toggle('vg-fb-active', brand === 'psa');
    renderSwatches(brand);
  }

  if (tagBtn) tagBtn.addEventListener('click', function () { setBrand('tag'); });
  if (psaBtn) psaBtn.addEventListener('click', function () { setBrand('psa'); });

  if (upload) {
    upload.addEventListener('change', function (e) {
      var file = e.target.files && e.target.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (evt) {
        photo.src = evt.target.result;
        photo.style.display = 'block';
        if (placeholder) placeholder.style.display = 'none';
      };
      reader.readAsDataURL(file);
    });
  }

  if (addCartBtn) {
    addCartBtn.addEventListener('click', function () {
      if (!currentProduct || !currentProduct.id) return;
      addCartBtn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: currentProduct.id, quantity: 1 })
      })
        .then(function (res) { return res.json(); })
        .then(function () {
          if (cartMsg) cartMsg.style.display = 'block';
          addCartBtn.disabled = false;
        })
        .catch(function () {
          addCartBtn.disabled = false;
        });
    });
  }

  setBrand('tag');
})();
</script>

{% schema %}
{
  "name": "Vaultguards Vault",
  "settings": []
}
{% endschema %}
