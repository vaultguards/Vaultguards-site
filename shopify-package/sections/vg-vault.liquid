{% comment %}
  VAULTGUARDS - The Vault Section (virtual try-on), connected to real
  products. Fully client-side: no server, no data storage. A visitor picks
  their slab brand, uploads a photo (stays only in their own browser tab -
  nothing is sent anywhere or saved), aligns it with a pinch/drag guide, then
  previews it composited with the REAL guard product photo for every real
  colorway - the frame around their card is the actual plastic guard photo
  (true color, texture, sheen), not a flat tint. From there they can jump to
  that product page or add it straight to cart.

  CONFIG: edit the two handles below if your collection handles ever change.

  This theme only exposes a JSON view for page templates (no plain Liquid
  template file to paste into), so this ships as a SECTION instead. Sections
  are added on top of the page through the theme editor.

  INSTALL:
  1. Admin > Online Store > Themes > Edit code.
  2. In the left sidebar, find "Sections" > click the plus icon next to it >
     name the new file "vg-vault" (it will be saved as
     sections/vg-vault.liquid) > select all the placeholder text > delete >
     paste this whole file in > Save.
  3. Online Store > Pages > Add page. Title it "The Vault". Set the URL
     handle to exactly "the-vault" (every other file already links to
     /pages/the-vault - matching this handle means zero other edits anywhere
     else on the site). Save.
  4. Go to Online Store > Themes > Customize.
  5. At the very top of the Customize screen there is a page picker
     dropdown. Switch it to "Pages" > choose the "The Vault" page you just
     created.
  6. In the left panel, scroll to the bottom of the section list and click
     "Add section" > find "Vaultguards Vault" > click it to add it.
  7. Remove or hide any other sections already on this page template so only
     Vaultguards Vault shows.
  8. Click Save in the top right.
  9. Open your storefront > click "Try It On" in the nav, or visit
     /pages/the-vault directly > pick a brand, upload a photo, align it,
     preview every colorway, try Add to Cart.
{% endcomment %}

{% assign tag_collection_handle = 'tag-guards-shimmer-series' %}
{% assign psa_collection_handle = 'shimmer-series' %}
{% assign tag_collection = collections[tag_collection_handle] %}
{% assign psa_collection = collections[psa_collection_handle] %}

<section class="vg-section vg-vault-root" style="padding-top:56px;">
  <div class="vg-container" style="max-width:680px; text-align:center; margin-bottom:20px;">
    <div class="vg-eyebrow">Virtual Try-On</div>
    <h1 style="font-size:40px; margin-top:14px;">Welcome to The Vault.</h1>
    <p style="color:var(--vg-navy-400); margin-top:12px; font-size:16px;">
      Upload a photo of your slab, align it, and preview every real colorway before you
      buy. Your photo stays in your browser only - nothing is uploaded or saved anywhere.
    </p>
  </div>

  <div class="vg-container" style="max-width:920px;">
    <div id="vg-vault-steps" style="display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; margin-bottom:24px;">
      <div class="vgv-step" data-step="1"><span class="vgv-step-num">1</span> Brand</div>
      <div class="vgv-step-line"></div>
      <div class="vgv-step" data-step="2"><span class="vgv-step-num">2</span> Upload</div>
      <div class="vgv-step-line"></div>
      <div class="vgv-step" data-step="3"><span class="vgv-step-num">3</span> Align</div>
      <div class="vgv-step-line"></div>
      <div class="vgv-step" data-step="4"><span class="vgv-step-num">4</span> Preview &amp; Buy</div>
    </div>

    {% comment %} ===== STEP 1: BRAND ===== {% endcomment %}
    <div class="vgv-panel" id="vgv-panel-brand">
      <div class="vg-card" style="padding:28px;">
        <h2 style="font-size:22px; margin-bottom:6px; text-align:center;">Which brand is your slab?</h2>
        <p style="text-align:center; color:var(--vg-navy-400); font-size:14px; margin-bottom:30px;">
          This sets the slab shape used for alignment and which colorways you can preview.
        </p>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <button type="button" class="vgv-brand-btn" data-brand="tag" data-vg-haptic="tap">
            <div class="vgv-brand-swatch" style="background:linear-gradient(135deg,#eee,#ccc);"></div>
            <img src="{{ 'tag-logo.png' | asset_url }}" alt="TAG" class="vgv-brand-logo" width="76" height="28">
          </button>
          <button type="button" class="vgv-brand-btn" data-brand="psa" data-vg-haptic="tap">
            <div class="vgv-brand-swatch" style="background:linear-gradient(135deg,#dbe7f7,#9fc0e8);"></div>
            <img src="{{ 'psa-logo.png' | asset_url }}" alt="PSA" class="vgv-brand-logo" width="70" height="28">
          </button>
        </div>
      </div>
    </div>

    {% comment %} ===== STEP 2: UPLOAD ===== {% endcomment %}
    <div class="vgv-panel" id="vgv-panel-upload" style="display:none;">
      <div class="vg-card" style="padding:28px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:22px; flex-wrap:wrap; gap:10px;">
          <h2 style="font-size:22px;">Upload your slab photo</h2>
          <button type="button" class="vg-btn vg-btn-ghost" style="padding:8px 16px; font-size:12.5px;" data-vgv-back="1">
            <i class="fa-solid fa-arrow-left"></i> Change brand
          </button>
        </div>

        <div class="vg-card-flat" style="padding:16px 20px; display:flex; gap:14px; align-items:flex-start; margin-bottom:24px;">
          <i class="fa-solid fa-camera" style="color:var(--vg-gold-500); font-size:18px; margin-top:2px;"></i>
          <div style="font-size:13.5px; color:var(--vg-navy-600); line-height:1.6;">
            For the cleanest result: place your slab on a flat, well-lit surface and fill
            most of the camera frame with it - shoot straight-on, not at an angle.
          </div>
        </div>

        <div id="vgv-dropzone" class="vgv-dropzone">
          <input type="file" id="vgv-upload-input" accept="image/*" style="display:none;">
          <input type="file" id="vgv-camera-input" accept="image/*" capture="environment" style="display:none;">
          <i class="fa-solid fa-cloud-arrow-up" style="font-size:30px; color:var(--vg-gold-500);"></i>
          <div style="font-weight:600; margin-top:12px;">Tap to upload a photo</div>
          <div style="color:var(--vg-navy-400); font-size:12.5px; margin-top:4px;">JPG or PNG - background removed automatically</div>
          <button type="button" id="vgv-camera-btn" class="vg-btn vg-btn-ghost" style="margin-top:18px; padding:9px 18px; font-size:12.5px;">
            <i class="fa-solid fa-camera"></i> Take a Photo Instead
          </button>
        </div>

        <div id="vgv-upload-progress" style="display:none; text-align:center; padding:30px 0;">
          <div class="vgv-spinner"></div>
          <div id="vgv-upload-progress-label" style="margin-top:14px; font-size:14px; color:var(--vg-navy-500);">Removing background...</div>
          <div style="font-size:12px; color:var(--vg-navy-400); margin-top:6px;">First run downloads a small on-device model - this can take a moment.</div>
        </div>
      </div>
    </div>

    {% comment %} ===== STEP 3: ALIGN ===== {% endcomment %}
    <div class="vgv-panel" id="vgv-panel-align" style="display:none;">
      <div class="vg-card" style="padding:28px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; flex-wrap:wrap; gap:10px;">
          <h2 style="font-size:22px;">Align your slab</h2>
          <button type="button" class="vg-btn vg-btn-ghost" style="padding:8px 16px; font-size:12.5px;" data-vgv-back="2">
            <i class="fa-solid fa-arrow-left"></i> Retake photo
          </button>
        </div>
        <p style="color:var(--vg-navy-400); font-size:13.5px; margin-bottom:22px;">
          Drag to position, pinch or scroll to zoom until your slab fills the guide.
        </p>

        <div id="vgv-align-stage" class="vgv-align-stage">
          <canvas id="vgv-align-canvas" width="700" height="875"></canvas>
          <div id="vgv-align-guide" class="vgv-align-guide"></div>
        </div>

        <div style="display:flex; align-items:center; gap:14px; margin-top:22px; max-width:420px; margin-left:auto; margin-right:auto;">
          <i class="fa-solid fa-magnifying-glass-minus" style="color:var(--vg-navy-400);"></i>
          <input type="range" id="vgv-align-zoom" min="50" max="300" value="100" style="flex:1;">
          <i class="fa-solid fa-magnifying-glass-plus" style="color:var(--vg-navy-400);"></i>
        </div>

        <div style="text-align:center; margin-top:26px;">
          <button type="button" class="vg-btn vg-btn-primary" id="vgv-align-confirm-btn" data-vg-haptic="success">
            Looks good <i class="fa-solid fa-check"></i>
          </button>
        </div>
      </div>
    </div>

    {% comment %} ===== STEP 4: PREVIEW & BUY ===== {% endcomment %}
    <div class="vgv-panel" id="vgv-panel-preview" style="display:none;">
      <div class="vgv-preview-grid">
        <div class="vg-card" style="padding:24px;" id="vgv-preview-image-card">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
            <span class="vg-pill vg-pill-gold" id="vgv-preview-brand-pill">TAG</span>
            <button type="button" class="vg-btn vg-btn-ghost" style="padding:7px 14px; font-size:12px;" data-vgv-back="3">
              <i class="fa-solid fa-arrow-left"></i> Re-align
            </button>
          </div>
          <div id="vgv-preview-stage" class="vgv-preview-stage">
            <canvas id="vgv-preview-canvas" width="800" height="1000"></canvas>
          </div>
          <div id="vgv-oos-note" style="display:none; text-align:center; font-size:12.5px; color:var(--vg-navy-400); margin-top:14px;"></div>
        </div>

        <div>
          <div id="vgv-selected" style="margin-bottom:16px;">
            <h2 style="font-size:20px; margin-bottom:4px;" id="vgv-selected-title">&nbsp;</h2>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
              <span id="vgv-selected-price" style="color:var(--vg-navy-400); font-size:14.5px;"></span>
              <span id="vgv-selected-stock" class="vg-pill" style="font-size:10.5px; padding:3px 10px;"></span>
            </div>
          </div>

          <div style="margin-bottom:8px; font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:var(--vg-navy-400);">
            Pick a colorway - previewed with YOUR photo
          </div>
          <div id="vgv-swatch-grid" class="vgv-swatch-grid"></div>

          <button type="button" class="vg-btn vg-btn-primary" id="vgv-add-cart" style="width:100%; padding:16px;" data-vg-haptic="tap" disabled>
            <i class="fa-solid fa-bag-shopping"></i> Add to Cart
          </button>
          <div id="vgv-cart-note" style="font-size:12px; color:var(--vg-navy-400); text-align:center; margin-top:10px;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% comment %} ---- Build real product data as JSON, safely escaped by the json filter ---- {% endcomment %}
{% capture tag_products_json %}[
  {% for product in tag_collection.products %}
    {
      "id": {{ product.selected_or_first_available_variant.id | default: 0 }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "priceCents": {{ product.price }},
      "available": {{ product.available }},
      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}""{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]{% endcapture %}

{% capture psa_products_json %}[
  {% for product in psa_collection.products %}
    {
      "id": {{ product.selected_or_first_available_variant.id | default: 0 }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "priceCents": {{ product.price }},
      "available": {{ product.available }},
      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}""{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]{% endcapture %}

<style>
  .vgv-step { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--vg-navy-300); padding: 6px 4px; }
  .vgv-step.vgv-step-active { color: var(--vg-navy-900); }
  .vgv-step.vgv-step-done { color: var(--vg-gold-500); }
  .vgv-step-num { width: 24px; height: 24px; border-radius: 50%; background: var(--vg-ivory-200); display: flex; align-items: center; justify-content: center; font-size: 12px; transition: background var(--vg-dur-fast) var(--vg-ease-soft), color var(--vg-dur-fast) var(--vg-ease-soft); }
  .vgv-step-active .vgv-step-num { background: var(--vg-navy-900); color: #fff; }
  .vgv-step-done .vgv-step-num { background: var(--vg-gold-400); color: #2a1f08; }
  .vgv-step-line { width: 32px; height: 1px; background: var(--vg-ivory-300); }

  .vgv-brand-btn { border: none; background: var(--vg-ivory-50); border-radius: var(--vg-radius-md); padding: 30px 20px; cursor: pointer; box-shadow: var(--vg-shadow-sm); transition: box-shadow var(--vg-dur-fast) var(--vg-ease-soft), transform var(--vg-dur-fast) var(--vg-ease-soft); text-align: center; -webkit-tap-highlight-color: transparent; }
  .vgv-brand-btn:hover { box-shadow: var(--vg-shadow-md); transform: translateY(-3px); }
  .vgv-brand-btn.vgv-brand-selected { box-shadow: 0 0 0 3px var(--vg-gold-400), var(--vg-shadow-md); }
  .vgv-brand-swatch { width: 64px; height: 96px; margin: 0 auto; border-radius: 10px; box-shadow: var(--vg-shadow-xs), inset 0 0 0 1px rgba(0,0,0,0.04); }
  .vgv-brand-logo { height: 28px; width: auto; display: block; margin: 14px auto 0; object-fit: contain; }

  .vgv-dropzone { border: none; border-radius: var(--vg-radius-md); background: var(--vg-ivory-50); box-shadow: var(--vg-shadow-inset), var(--vg-shadow-xs); padding: 52px 20px; text-align: center; cursor: pointer; transition: box-shadow var(--vg-dur-fast) var(--vg-ease-soft); -webkit-tap-highlight-color: transparent; }
  .vgv-dropzone:hover { box-shadow: var(--vg-shadow-inset), var(--vg-shadow-sm); }
  .vgv-dropzone.vgv-drag-over { box-shadow: 0 0 0 3px var(--vg-gold-400); }

  .vgv-spinner { width: 34px; height: 34px; border-radius: 50%; border: 3px solid var(--vg-ivory-300); border-top-color: var(--vg-gold-500); margin: 0 auto; animation: vgvSpin 900ms linear infinite; }
  @keyframes vgvSpin { to { transform: rotate(360deg); } }

  .vgv-align-stage { position: relative; width: 100%; max-width: 420px; margin: 0 auto; aspect-ratio: 4/5; background: var(--vg-ivory-200); border-radius: var(--vg-radius-md); overflow: hidden; touch-action: none; cursor: grab; }
  .vgv-align-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: 100%; max-height: 100%; }
  .vgv-align-guide { position: absolute; border: 2px dashed rgba(111, 160, 190, 0.9); border-radius: 14px; pointer-events: none; box-shadow: 0 0 0 2000px rgba(20, 24, 31, 0.38); }

  .vgv-preview-stage { position: relative; width: 100%; max-width: 300px; margin: 0 auto; aspect-ratio: 4/5; background: var(--vg-ivory-50); border-radius: var(--vg-radius-md); overflow: hidden; }
  .vgv-preview-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: 100%; max-height: 100%; }

  .vgv-preview-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 30px; align-items: start; }
  #vgv-preview-image-card { position: sticky; top: 90px; }

  .vgv-swatch-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-bottom: 26px; }
  .vgv-swatch { width: 100%; border-radius: 12px; border: none; cursor: pointer; position: relative; background: var(--vg-surface); padding: 0 0 8px; box-shadow: var(--vg-shadow-xs); -webkit-tap-highlight-color: transparent; transition: transform var(--vg-dur-fast) var(--vg-ease-soft), box-shadow var(--vg-dur-fast) var(--vg-ease-soft); }
  .vgv-swatch:hover { transform: translateY(-2px); box-shadow: var(--vg-shadow-sm); }
  .vgv-swatch.vgv-swatch-active { box-shadow: 0 0 0 3px var(--vg-navy-900); }
  .vgv-swatch-thumb { position: relative; width: 100%; aspect-ratio: 4/5; background: var(--vg-ivory-50); }
  .vgv-swatch-thumb canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vgv-swatch-label { font-size: 11px; font-weight: 600; line-height: 1.2; color: var(--vg-navy-700); padding: 6px 6px 0; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vgv-swatch .vgv-swatch-oos-dot { position: absolute; top: 6px; right: 6px; width: 16px; height: 16px; border-radius: 50%; background: var(--vg-danger); box-shadow: 0 0 0 2px #fff; font-size: 8px; color: #fff; display: flex; align-items: center; justify-content: center; }

  .vgv-panel { animation: vgvFadeUp 480ms var(--vg-ease-out); }
  @keyframes vgvFadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 780px) { .vgv-preview-grid { grid-template-columns: 1fr; } #vgv-preview-image-card { position: static; } }
  @media (max-width: 640px) {
    .vgv-step { font-size: 0; gap: 0; padding: 4px; }
    .vgv-step-num { font-size: 12px; width: 26px; height: 26px; }
    .vgv-step-line { width: 14px; }
    .vgv-brand-btn { padding: 22px 12px; }
    .vgv-brand-swatch { width: 52px; height: 78px; }
    .vgv-brand-logo { height: 22px; margin-top: 10px; }
    .vgv-dropzone { padding: 36px 16px; }
    .vgv-preview-stage { max-width: 220px; }
    .vgv-swatch-grid { gap: 6px; }
    .vgv-swatch-label { font-size: 9.5px; padding-top: 4px; }
  }
  @media (max-width: 420px) {
    .vgv-swatch-grid { grid-template-columns: repeat(4, 1fr); }
    .vgv-preview-stage { max-width: 180px; }
  }
</style>

<script>
(function () {
  var VG_VAULT_PRODUCTS = {
    tag: {{ tag_products_json }},
    psa: {{ psa_products_json }}
  };
  // Both brands' values below are used ONLY as the generic guide shown
  // during the align step (before a specific color is chosen) - each is a
  // representative average, not a per-photo truth. The real per-photo
  // window for both brands is computed at runtime by
  // detectContentBox()/getGuardWindowRect() below.
  // See VAULTGUARDS_METHOD.md section "PSA guard auto-centering" (6c),
  // "PSA align-guide/window shape correction" (6d) and "TAG guard
  // auto-centering + align-guide correction" (6e) for the full measurement
  // method and data behind both these fixed values and
  // GUARD_WINDOW_AUTO_MARGIN.
  //
  // Both sets of percentages below are NOT an independent guess - they are
  // the MEDIAN photo-object position across all real guard photos of that
  // brand (14 for PSA, 9 for TAG), with GUARD_WINDOW_AUTO_MARGIN's margins
  // for that brand applied on top, so each fixed guide has the same true
  // window shape that the real runtime auto-detected windows produce for
  // that brand.
  //
  // TAG's value was originally derived from TAG's own published slab
  // dimensions (5.25in x 3.125in, https://help.taggrading.com) as a
  // theoretical width:height ratio (~0.595). That theoretical value was
  // superseded in 6e by a user-hand-marked ground truth on a real TAG guard
  // photo (the same "mark the true guard-to-slab edge" method used for PSA
  // in 6d) - the theoretical published-dimension ratio turned out to run
  // ~5% narrower/taller than the guard's actual real-world window opening,
  // which is what this measured value corrects.
  var GUARD_WINDOW = {
    tag: { top: 17.14, left: 25.70, right: 25.68, bottom: 20.87 },
    psa: { top: 11.25, left: 23.60, right: 21.48, bottom: 12.70 }
  };

  // Auto-center config for brands whose product photos vary shot-to-shot.
  // For each such brand, the window is derived at runtime from THAT PHOTO'S
  // own detected visible (non-white) bounding box, then inset by a fixed
  // proportion of that box's own width/height - so it "auto centers" against
  // whatever the real photo actually shows instead of assuming one universal
  // position.
  //
  // These margins are NOT an eyeballed guess - they were reverse-engineered
  // from a real ground-truth boundary the user hand-marked directly on one
  // of our own diagnostic overlay photos: the true edge where a guard's
  // colored decorative frame ends and the actual slab body begins (i.e.
  // exactly the area a real uploaded slab photo should be mapped onto).
  //
  // PSA: measuring that hand-marked box against the auto-detected outer
  // (guard+slab) box gave left=5.9%, right=7.2%, top=3.4%, bottom=4.0% of
  // the outer box's own width/height; symmetrized to left=right=6.56%,
  // top=bottom=3.72% (the ~1pp asymmetry is consistent with normal freehand
  // marking noise, not a real design asymmetry). Re-verified by re-applying
  // these exact margins to 6 different real PSA guard photos (multiple
  // colors) and visually confirming the resulting window lands exactly on
  // that same guard-to-slab boundary in every one - see VAULTGUARDS_METHOD.md
  // section 6d. This also produces a near-constant window aspect ratio
  // (0.568-0.576) across all 14 real photos, vs. the old margins' ~0.48-0.49,
  // which is what fixed "extra space top/bottom" once a real slab photo is
  // scaled into this window.
  //
  // TAG: same method (see 6e) - user hand-marked the guard-to-slab edge on
  // a real TAG photo, measured (calibrated against known reference lines on
  // the same diagnostic image for sub-pixel accuracy) at left=4.45%,
  // right=4.41%, top=2.94%, bottom=2.58% of the outer box; symmetrized to
  // left=right=4.43%, top=bottom=2.76%. This superseded an earlier TAG
  // margin set that had been reverse-engineered purely from TAG's
  // theoretical published slab-dimension ratio - that theoretical value ran
  // consistently ~5% narrower/taller than the real hand-marked boundary
  // across all 9 real TAG photos tested (displayed window ratio 0.625-0.630
  // with the corrected margins vs. only ~0.595 in theory), which is exactly
  // why the previous TAG window looked "a little off" against a real photo.
  var GUARD_WINDOW_AUTO_MARGIN = {
    psa: { left: 0.0656, right: 0.0656, top: 0.0372, bottom: 0.0372 },
    tag: { left: 0.0443, right: 0.0443, top: 0.0276, bottom: 0.0276 }
  };

  // Detects the visible (non-white) bounding box of a loaded guard product
  // photo, as fractions (0..1) of its own width/height. Downscales onto a
  // small offscreen canvas first purely for speed - a few hundred px is
  // already far more resolution than this needs, since guard photos are
  // shot on a plain white background with a single centered object. Returns
  // null if the canvas can't be read (e.g. a CORS-blocked image) so callers
  // can fall back to the fixed GUARD_WINDOW percentages.
  function detectContentBox(img) {
    var w = img.naturalWidth || img.width;
    var h = img.naturalHeight || img.height;
    if (!w || !h) return null;
    var scale = Math.min(1, 240 / w);
    var cw = Math.max(1, Math.round(w * scale));
    var ch = Math.max(1, Math.round(h * scale));
    var c = document.createElement('canvas');
    c.width = cw; c.height = ch;
    var cctx = c.getContext('2d');
    cctx.drawImage(img, 0, 0, cw, ch);
    var data;
    try {
      data = cctx.getImageData(0, 0, cw, ch).data;
    } catch (e) {
      return null;
    }
    var minX = cw, maxX = -1, minY = ch, maxY = -1;
    var THRESH = 12;
    for (var y = 0; y < ch; y++) {
      for (var x = 0; x < cw; x++) {
        var i = (y * cw + x) * 4;
        var r = data[i], g = data[i + 1], b = data[i + 2];
        if ((255 - r) > THRESH || (255 - g) > THRESH || (255 - b) > THRESH) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    if (maxX < 0 || maxY < 0) return null;
    return {
      left: minX / cw,
      right: (maxX + 1) / cw,
      top: minY / ch,
      bottom: (maxY + 1) / ch
    };
  }

  // Builds the actual window rect (in canvas px) for one guard photo: uses
  // the auto-detected content box + proportional margin when configured and
  // available for this brand, otherwise falls back to the fixed
  // GUARD_WINDOW percentages (used for both brands during the pre-upload
  // align-guide step, before any specific photo has been loaded/detected).
  function getGuardWindowRect(brand, guardImg, W, H) {
    var autoMargin = GUARD_WINDOW_AUTO_MARGIN[brand];
    var box = guardImg && guardImg.__vgvContentBox;
    if (autoMargin && box) {
      var boxW = (box.right - box.left) * W;
      var boxH = (box.bottom - box.top) * H;
      var x = box.left * W + autoMargin.left * boxW;
      var right = box.right * W - autoMargin.right * boxW;
      var y = box.top * H + autoMargin.top * boxH;
      var bottom = box.bottom * H - autoMargin.bottom * boxH;
      return { x: x, y: y, w: right - x, h: bottom - y };
    }
    var win = GUARD_WINDOW[brand] || GUARD_WINDOW.tag;
    var x2 = (win.left / 100) * W;
    var y2 = (win.top / 100) * H;
    var w2 = W - x2 - (win.right / 100) * W;
    var h2 = H - y2 - (win.bottom / 100) * H;
    return { x: x2, y: y2, w: w2, h: h2 };
  }

  var haptic = (window.VG && window.VG.haptic) || { tap: function () {}, success: function () {}, warn: function () {}, snap: function () {} };

  var STEP_ORDER = ['brand', 'upload', 'align', 'preview'];
  var state = {
    brand: null,
    slabImage: null,
    slabNaturalAspect: 1,
    align: { x: 0, y: 0, scale: 1 },
    products: [],
    activeProduct: null
  };

  function goToStep(name) {
    STEP_ORDER.forEach(function (s) {
      var panel = document.getElementById('vgv-panel-' + s);
      if (panel) panel.style.display = s === name ? '' : 'none';
    });
    document.querySelectorAll('.vgv-step').forEach(function (el) {
      var idx = parseInt(el.getAttribute('data-step'), 10) - 1;
      var curIdx = STEP_ORDER.indexOf(name);
      el.classList.remove('vgv-step-active', 'vgv-step-done');
      if (idx < curIdx) el.classList.add('vgv-step-done');
      else if (idx === curIdx) el.classList.add('vgv-step-active');
    });
    haptic.snap();
  }

  document.querySelectorAll('[data-vgv-back]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = parseInt(btn.getAttribute('data-vgv-back'), 10);
      goToStep(STEP_ORDER[target - 1]);
    });
  });

  function formatPrice(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function roundRectPath(ctx, x, y, w, h, r) {
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  // -------------------------------------------------------------------
  // Step 1: brand
  // -------------------------------------------------------------------
  document.querySelectorAll('.vgv-brand-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.vgv-brand-btn').forEach(function (b) { b.classList.remove('vgv-brand-selected'); });
      btn.classList.add('vgv-brand-selected');
      state.brand = btn.getAttribute('data-brand');
      state.products = VG_VAULT_PRODUCTS[state.brand] || [];
      haptic.success();
      setTimeout(function () { goToStep('upload'); }, 220);
    });
  });

  // -------------------------------------------------------------------
  // Step 2: upload + client-side background removal
  // -------------------------------------------------------------------
  var dropzone = document.getElementById('vgv-dropzone');
  var fileInput = document.getElementById('vgv-upload-input');
  var cameraInput = document.getElementById('vgv-camera-input');
  var cameraBtn = document.getElementById('vgv-camera-btn');
  var progressEl = document.getElementById('vgv-upload-progress');
  var progressLabel = document.getElementById('vgv-upload-progress-label');
  var _bgRemovalModulePromise = null;

  function loadBgRemoval() {
    if (!_bgRemovalModulePromise) {
      // IMPORTANT: must use jsDelivr's "+esm" combined-ESM endpoint, NOT the
      // raw dist/index.mjs file. The raw dist file contains bare module
      // specifiers (import("onnxruntime-web")) meant to be resolved by a
      // bundler at build time - loaded directly in a browser via <script>
      // import(), that throws "Failed to resolve module specifier
      // 'onnxruntime-web'" every single time, which this code's catch()
      // was silently swallowing as "background removal unavailable". The
      // +esm endpoint rewrites those bare imports into real CDN URLs so it
      // works with zero build step. Verified end-to-end in a real browser.
      _bgRemovalModulePromise = import('https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.7.0/+esm');
    }
    return _bgRemovalModulePromise;
  }

  if (dropzone) dropzone.addEventListener('click', function (e) {
    if (cameraBtn && (e.target === cameraBtn || cameraBtn.contains(e.target))) return;
    fileInput.click();
  });
  if (cameraBtn) cameraBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    if (cameraInput) cameraInput.click();
  });
  ['dragover', 'dragleave', 'drop'].forEach(function (evt) {
    if (!dropzone) return;
    dropzone.addEventListener(evt, function (e) {
      e.preventDefault();
      dropzone.classList.toggle('vgv-drag-over', evt === 'dragover');
    });
  });
  if (dropzone) dropzone.addEventListener('drop', function (e) {
    var f = e.dataTransfer.files && e.dataTransfer.files[0];
    if (f) handleFile(f);
  });
  if (fileInput) fileInput.addEventListener('change', function () {
    if (fileInput.files && fileInput.files[0]) handleFile(fileInput.files[0]);
  });
  if (cameraInput) cameraInput.addEventListener('change', function () {
    if (cameraInput.files && cameraInput.files[0]) handleFile(cameraInput.files[0]);
  });

  function useImageAsIs(objectUrl, note) {
    var img = new Image();
    img.onload = function () {
      state.slabImage = img;
      state.slabNaturalAspect = img.naturalWidth / img.naturalHeight;
      state.align = { x: 0, y: 0, scale: 1 };
      progressEl.style.display = 'none';
      dropzone.style.display = '';
      if (note) progressLabel.textContent = note;
      goToStep('align');
      initAlignStage();
    };
    img.onerror = function () {
      progressLabel.textContent = 'Could not load that photo - please try another.';
      progressEl.style.display = 'none';
      dropzone.style.display = '';
    };
    img.src = objectUrl;
  }

  function handleFile(file) {
    dropzone.style.display = 'none';
    progressEl.style.display = '';
    progressLabel.textContent = 'Removing background...';
    var objectUrl = URL.createObjectURL(file);

    loadBgRemoval()
      .then(function (mod) {
        var removeBackground = mod.removeBackground || mod.default;
        if (typeof removeBackground !== 'function') {
          throw new Error('removeBackground export not found on module');
        }
        return removeBackground(objectUrl, {
          // Quantized/small model (~40MB vs ~80MB default) - this storefront
          // can't set the cross-origin-isolation headers that would enable
          // multi-threaded WASM, so it always runs single-threaded; the
          // smaller model keeps first-run time reasonable on that path.
          model: 'isnet_quint8',
          progress: function (key, current, total) {
            if (total > 0) {
              var pct = Math.round((current / total) * 100);
              progressLabel.textContent = 'Preparing on-device model... ' + pct + '%';
            }
          }
        });
      })
      .then(function (blob) {
        var url = URL.createObjectURL(blob);
        haptic.success();
        useImageAsIs(url);
      })
      .catch(function (err) {
        // Log the real reason to the console so this is diagnosable from
        // browser devtools instead of failing silently. The UI still falls
        // back to the original (background-intact) photo so the tool stays
        // usable even if a visitor's browser/network blocks the download.
        console.error('[Vaultguards Vault] Background removal failed, using original photo:', err);
        useImageAsIs(objectUrl, 'Background removal unavailable - using original photo.');
      });
  }

  // -------------------------------------------------------------------
  // Step 3: pinch-to-zoom / drag alignment
  // -------------------------------------------------------------------
  var alignCanvas = document.getElementById('vgv-align-canvas');
  var alignCtx = alignCanvas.getContext('2d');
  var alignGuideEl = document.getElementById('vgv-align-guide');
  var alignZoomSlider = document.getElementById('vgv-align-zoom');
  var alignStage = document.getElementById('vgv-align-stage');

  function guideRectForBrand() {
    var win = GUARD_WINDOW[state.brand] || GUARD_WINDOW.tag;
    var stageW = alignCanvas.width;
    var stageH = alignCanvas.height;
    var x = (win.left / 100) * stageW;
    var y = (win.top / 100) * stageH;
    var w = stageW - x - (win.right / 100) * stageW;
    var h = stageH - y - (win.bottom / 100) * stageH;
    return { x: x, y: y, w: w, h: h };
  }

  function positionGuideOverlay() {
    var rect = guideRectForBrand();
    var stageRect = alignStage.getBoundingClientRect();
    var scaleX = stageRect.width / alignCanvas.width;
    var scaleY = stageRect.height / alignCanvas.height;
    alignGuideEl.style.left = (rect.x * scaleX) + 'px';
    alignGuideEl.style.top = (rect.y * scaleY) + 'px';
    alignGuideEl.style.width = (rect.w * scaleX) + 'px';
    alignGuideEl.style.height = (rect.h * scaleY) + 'px';
  }

  function drawAlignStage() {
    alignCtx.clearRect(0, 0, alignCanvas.width, alignCanvas.height);
    alignCtx.fillStyle = '#EFEAE0';
    alignCtx.fillRect(0, 0, alignCanvas.width, alignCanvas.height);
    if (state.slabImage) {
      var cx = alignCanvas.width / 2 + state.align.x;
      var cy = alignCanvas.height / 2 + state.align.y;
      var baseH = alignCanvas.height * 0.5 * state.align.scale;
      var baseW = baseH * state.slabNaturalAspect;
      alignCtx.drawImage(state.slabImage, cx - baseW / 2, cy - baseH / 2, baseW, baseH);
    }
  }

  var dragging = false;
  var lastPointer = null;
  var pinchStartDist = null;
  var pinchStartScale = 1;
  var activePointers = new Map();

  function distBetween(p1, p2) {
    return Math.hypot(p1.x - p2.x, p1.y - p2.y);
  }

  function initAlignStage() {
    positionGuideOverlay();
    drawAlignStage();
  }

  alignStage.addEventListener('pointerdown', function (e) {
    alignStage.setPointerCapture(e.pointerId);
    activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (activePointers.size === 1) {
      dragging = true;
      lastPointer = { x: e.clientX, y: e.clientY };
    } else if (activePointers.size === 2) {
      dragging = false;
      var pts = Array.from(activePointers.values());
      pinchStartDist = distBetween(pts[0], pts[1]);
      pinchStartScale = state.align.scale;
    }
  });

  alignStage.addEventListener('pointermove', function (e) {
    if (!activePointers.has(e.pointerId)) return;
    activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (activePointers.size === 2) {
      var pts = Array.from(activePointers.values());
      var d = distBetween(pts[0], pts[1]);
      if (pinchStartDist) {
        var next = pinchStartScale * (d / pinchStartDist);
        state.align.scale = Math.max(0.5, Math.min(3, next));
        alignZoomSlider.value = Math.round(state.align.scale * 100);
        drawAlignStage();
      }
      return;
    }

    if (dragging && lastPointer) {
      var stageRect = alignStage.getBoundingClientRect();
      var scaleX = alignCanvas.width / stageRect.width;
      var scaleY = alignCanvas.height / stageRect.height;
      var dx = (e.clientX - lastPointer.x) * scaleX;
      var dy = (e.clientY - lastPointer.y) * scaleY;
      state.align.x += dx;
      state.align.y += dy;
      lastPointer = { x: e.clientX, y: e.clientY };
      drawAlignStage();
    }
  });

  function endPointer(e) {
    activePointers.delete(e.pointerId);
    if (activePointers.size < 2) pinchStartDist = null;
    if (activePointers.size === 0) dragging = false;
  }
  alignStage.addEventListener('pointerup', endPointer);
  alignStage.addEventListener('pointercancel', endPointer);
  alignStage.addEventListener('pointerleave', function () {
    if (activePointers.size <= 1) dragging = false;
  });

  alignStage.addEventListener('wheel', function (e) {
    e.preventDefault();
    var delta = e.deltaY > 0 ? -0.05 : 0.05;
    state.align.scale = Math.max(0.5, Math.min(3, state.align.scale + delta));
    alignZoomSlider.value = Math.round(state.align.scale * 100);
    drawAlignStage();
  }, { passive: false });

  alignZoomSlider.addEventListener('input', function () {
    state.align.scale = parseInt(alignZoomSlider.value, 10) / 100;
    drawAlignStage();
  });

  window.addEventListener('resize', function () {
    var alignPanel = document.getElementById('vgv-panel-align');
    if (alignPanel && alignPanel.style.display !== 'none') positionGuideOverlay();
  });

  document.getElementById('vgv-align-confirm-btn').addEventListener('click', function () {
    goToStep('preview');
    initPreviewPanel();
  });

  // -------------------------------------------------------------------
  // Step 4: real-photo compositing + preview + add to cart
  // -------------------------------------------------------------------
  var previewCanvas = document.getElementById('vgv-preview-canvas');
  var previewCtx = previewCanvas.getContext('2d');
  var guardImageCache = {};

  function loadGuardImage(product) {
    if (guardImageCache[product.id]) return Promise.resolve(guardImageCache[product.id]);
    return new Promise(function (resolve, reject) {
      var img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = function () {
        // Computed once per photo and cached on the Image itself - see
        // detectContentBox() above for why this exists (PSA auto-centering).
        img.__vgvContentBox = detectContentBox(img);
        guardImageCache[product.id] = img;
        resolve(img);
      };
      img.onerror = reject;
      img.src = product.image;
    });
  }

  function drawGuardComposite(ctx, W, H, guardImg) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0, 0, W, H);

    var winRect = getGuardWindowRect(state.brand, guardImg, W, H);
    var winX = winRect.x, winY = winRect.y, winW = winRect.w, winH = winRect.h;
    var r = Math.max(2, Math.round(W * 0.0125));

    if (state.slabImage) {
      ctx.save();
      ctx.beginPath();
      roundRectPath(ctx, winX, winY, winW, winH, r);
      ctx.clip();

      var guide = guideRectForBrand();
      var relX = (alignCanvas.width / 2 + state.align.x - guide.x) / guide.w;
      var relY = (alignCanvas.height / 2 + state.align.y - guide.y) / guide.h;
      var baseHRatio = (alignCanvas.height * 0.5 * state.align.scale) / guide.h;
      var slabH = winH * baseHRatio;
      var slabW = slabH * state.slabNaturalAspect;
      var slabCx = winX + relX * winW;
      var slabCy = winY + relY * winH;

      ctx.drawImage(state.slabImage, slabCx - slabW / 2, slabCy - slabH / 2, slabW, slabH);
      ctx.restore();
    }

    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 0, W, H);
    roundRectPath(ctx, winX, winY, winW, winH, r);
    ctx.clip('evenodd');
    ctx.drawImage(guardImg, 0, 0, W, H);
    ctx.restore();
  }

  function compositePreview(product) {
    var W = previewCanvas.width, H = previewCanvas.height;
    loadGuardImage(product).then(function (guardImg) {
      drawGuardComposite(previewCtx, W, H, guardImg);
    }).catch(function () {
      previewCtx.clearRect(0, 0, W, H);
      previewCtx.fillStyle = '#D8DEE3';
      previewCtx.fillRect(0, 0, W, H);
    });
  }

  var SWATCH_THUMB_W = 160, SWATCH_THUMB_H = 200;

  function renderSwatchThumb(canvas, product) {
    var ctx = canvas.getContext('2d');
    loadGuardImage(product).then(function (guardImg) {
      drawGuardComposite(ctx, SWATCH_THUMB_W, SWATCH_THUMB_H, guardImg);
    }).catch(function () {
      ctx.fillStyle = '#D8DEE3';
      ctx.fillRect(0, 0, SWATCH_THUMB_W, SWATCH_THUMB_H);
    });
  }

  function renderSwatchGrid() {
    var grid = document.getElementById('vgv-swatch-grid');
    grid.innerHTML = '';
    state.products.forEach(function (p) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'vgv-swatch';
      btn.title = p.title + (p.available ? '' : ' (out of stock - preview only)');
      btn.setAttribute('data-vg-haptic', 'tap');

      var thumbWrap = document.createElement('div');
      thumbWrap.className = 'vgv-swatch-thumb';
      var canvas = document.createElement('canvas');
      canvas.width = SWATCH_THUMB_W;
      canvas.height = SWATCH_THUMB_H;
      thumbWrap.appendChild(canvas);
      if (!p.available) {
        var dot = document.createElement('span');
        dot.className = 'vgv-swatch-oos-dot';
        dot.innerHTML = '<i class="fa-solid fa-xmark"></i>';
        thumbWrap.appendChild(dot);
      }
      btn.appendChild(thumbWrap);

      var label = document.createElement('div');
      label.className = 'vgv-swatch-label';
      label.textContent = p.title;
      btn.appendChild(label);

      renderSwatchThumb(canvas, p);

      btn.addEventListener('click', function () { selectProduct(p); });
      grid.appendChild(btn);
    });
  }

  function updateSwatchActiveState() {
    var grid = document.getElementById('vgv-swatch-grid');
    Array.prototype.forEach.call(grid.children, function (btn, i) {
      btn.classList.toggle('vgv-swatch-active', state.products[i] === state.activeProduct);
    });
  }

  function selectProduct(p) {
    state.activeProduct = p;
    updateSwatchActiveState();

    document.getElementById('vgv-selected-title').textContent = p.title;
    document.getElementById('vgv-selected-price').textContent = formatPrice(p.priceCents);

    var stockPill = document.getElementById('vgv-selected-stock');
    if (p.available) {
      stockPill.textContent = 'In stock';
      stockPill.className = 'vg-pill vg-pill-in';
    } else {
      stockPill.textContent = 'Out of stock';
      stockPill.className = 'vg-pill vg-pill-out';
    }

    var addBtn = document.getElementById('vgv-add-cart');
    var note = document.getElementById('vgv-cart-note');
    addBtn.disabled = !p.available || !p.id;
    note.textContent = p.available
      ? ''
      : 'Preview available for out-of-stock colors - add to cart unlocks once restocked.';

    var oosNote = document.getElementById('vgv-oos-note');
    if (!p.available) {
      oosNote.style.display = 'block';
      oosNote.textContent = 'This colorway is currently out of stock - you can still preview it here.';
    } else {
      oosNote.style.display = 'none';
    }

    compositePreview(p);
    haptic.tap();
  }

  function initPreviewPanel() {
    document.getElementById('vgv-preview-brand-pill').textContent = state.brand.toUpperCase();
    renderSwatchGrid();
    var initial = state.products.filter(function (p) { return p.available; })[0] || state.products[0];
    if (initial) selectProduct(initial);
  }

  var addCartBtn = document.getElementById('vgv-add-cart');
  addCartBtn.addEventListener('click', function () {
    if (!state.activeProduct || !state.activeProduct.id) return;
    addCartBtn.disabled = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: state.activeProduct.id, quantity: 1 })
    })
      .then(function (res) { return res.json(); })
      .then(function () {
        haptic.success();
        var note = document.getElementById('vgv-cart-note');
        note.textContent = 'Added to cart.';
        addCartBtn.disabled = false;
        if (window.VG && VG.refreshCartCount) VG.refreshCartCount();
      })
      .catch(function () {
        addCartBtn.disabled = false;
      });
  });
})();
</script>

{% schema %}
{
  "name": "Vaultguards Vault",
  "settings": [],
  "presets": [
    {
      "name": "Vaultguards Vault"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
