<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">

  <style>
/* ==========================================================================
   Vaultguards - Design System ("The Vault" steel/gunmetal theme)
   ========================================================================== */
:root {
  --vg-ivory-50: #F4F4F5;
  --vg-ivory-100: #E6E7E9;
  --vg-ivory-200: #D2D4D7;
  --vg-ivory-300: #B7BABE;
  --vg-navy-900: #15171A;
  --vg-navy-800: #1E2023;
  --vg-navy-700: #2A2D30;
  --vg-navy-600: #3E4145;
  --vg-navy-500: #595D61;
  --vg-navy-400: #75797D;
  --vg-navy-300: #9CA0A3;
  --vg-gold-500: #63737B;
  --vg-gold-400: #8A99A1;
  --vg-gold-300: #B4BFC5;
  --vg-gold-050: #EBEDEE;
  --vg-success: #2E8B6F;
  --vg-danger: #B5453B;
  --vg-bg: var(--vg-ivory-100);
  --vg-bg-alt: var(--vg-ivory-50);
  --vg-surface: #FFFFFF;
  --vg-text: var(--vg-navy-900);
  --vg-text-muted: var(--vg-navy-400);
  --vg-shadow-xs: 0 1px 2px rgba(18,22,27,.05), 0 1px 1px rgba(18,22,27,.04);
  --vg-shadow-sm: 0 2px 8px rgba(18,22,27,.08), 0 1px 3px rgba(18,22,27,.05);
  --vg-shadow-md: 0 8px 24px rgba(18,22,27,.10), 0 2px 6px rgba(18,22,27,.06);
  --vg-shadow-lg: 0 20px 48px rgba(18,22,27,.16), 0 6px 16px rgba(18,22,27,.08);
  --vg-shadow-gold-glow: 0 8px 30px rgba(99,115,123,.30);
  --vg-shadow-inset: inset 0 1px 2px rgba(18,22,27,.08);
  --vg-radius-sm: 12px; --vg-radius-md: 18px; --vg-radius-lg: 26px; --vg-radius-xl: 34px; --vg-radius-pill: 999px;
  --vg-space-1: 4px; --vg-space-2: 8px; --vg-space-3: 12px; --vg-space-4: 20px; --vg-space-5: 32px; --vg-space-6: 48px; --vg-space-7: 72px; --vg-space-8: 112px;
  --vg-font-display: 'Space Grotesk','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --vg-font-body: 'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --vg-ease-out: cubic-bezier(.16,1,.3,1);
  --vg-ease-soft: cubic-bezier(.22,.61,.36,1);
  --vg-dur-fast: 180ms; --vg-dur-base: 420ms; --vg-dur-slow: 900ms;
}
.vg-root, .vg-root * { box-sizing: border-box; }
.vg-root { background: var(--vg-bg); color: var(--vg-text); font-family: var(--vg-font-body); font-size: 16px; line-height: 1.6; }
.vg-root img { max-width: 100%; display: block; }
.vg-root a { color: inherit; text-decoration: none; }
.vg-root h1, .vg-root h2, .vg-root h3, .vg-root h4 { font-family: var(--vg-font-display); font-weight: 600; letter-spacing: -0.015em; color: var(--vg-navy-900); margin: 0; }
.vg-eyebrow { font-family: var(--vg-font-body); font-size: 12px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--vg-gold-500); }
.vg-container { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 var(--vg-space-4); }
.vg-section { padding: var(--vg-space-8) 0; }
@media (max-width: 720px) { .vg-section { padding: var(--vg-space-6) 0; } .vg-container { padding: 0 var(--vg-space-3); } }
.vg-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
.vg-grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.vg-grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 22px; }
@media (max-width: 900px) { .vg-grid-4 { grid-template-columns: repeat(2,1fr); gap: 16px; } }
@media (max-width: 860px) { .vg-grid-2 { grid-template-columns: 1fr; gap: 36px; } .vg-grid-3 { grid-template-columns: 1fr; gap: 18px; } }
@media (max-width: 480px) { .vg-grid-4 { grid-template-columns: repeat(2,1fr); gap: 12px; } }
@media (max-width: 640px) { .vg-root h1 { font-size: clamp(32px,9vw,44px) !important; } .vg-root h2 { font-size: clamp(26px,7vw,32px) !important; } }
@media (max-width: 640px) { .vg-btn { width: 100%; } .vg-nav .vg-btn { width: auto; } }
@media (max-width: 720px) { .vg-footer-grid { grid-template-columns: 1fr 1fr !important; gap: 28px 20px !important; } }
@media (max-width: 480px) { .vg-footer-grid { grid-template-columns: 1fr !important; } }
.vg-card { background: var(--vg-surface); border-radius: var(--vg-radius-lg); box-shadow: var(--vg-shadow-md); border: none; transition: transform var(--vg-dur-base) var(--vg-ease-out), box-shadow var(--vg-dur-base) var(--vg-ease-out); }
.vg-card:hover { transform: translateY(-4px); box-shadow: var(--vg-shadow-lg); }
.vg-card-flat { background: var(--vg-ivory-50); border-radius: var(--vg-radius-md); box-shadow: var(--vg-shadow-sm); }
.vg-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--vg-font-body); font-weight: 600; font-size: 15px; padding: 15px 30px; border-radius: var(--vg-radius-pill); border: none; cursor: pointer; transition: transform var(--vg-dur-fast) var(--vg-ease-soft), box-shadow var(--vg-dur-fast) var(--vg-ease-soft), background var(--vg-dur-fast) var(--vg-ease-soft), opacity var(--vg-dur-fast) var(--vg-ease-soft); -webkit-tap-highlight-color: transparent; }
.vg-btn:active { transform: scale(.97); }
.vg-btn-primary { background: linear-gradient(180deg, var(--vg-navy-800), var(--vg-navy-900)); color: #FFFFFF !important; box-shadow: var(--vg-shadow-md); }
.vg-btn-primary:hover { box-shadow: var(--vg-shadow-lg); transform: translateY(-2px); }
.vg-btn-gold { background: linear-gradient(180deg, var(--vg-gold-400), var(--vg-gold-500)); color: #0B1620 !important; box-shadow: var(--vg-shadow-gold-glow); }
.vg-btn-gold:hover { box-shadow: 0 12px 36px rgba(99,115,123,.4); transform: translateY(-2px); }
.vg-btn-ghost { background: var(--vg-ivory-50); color: var(--vg-navy-900) !important; box-shadow: var(--vg-shadow-sm); }
.vg-btn-ghost:hover { box-shadow: var(--vg-shadow-md); }
.vg-btn:disabled { opacity: .42; cursor: not-allowed; box-shadow: none; transform: none !important; }
.vg-announce { background: var(--vg-navy-900); color: var(--vg-ivory-100); text-align: center; font-size: 12.5px; font-weight: 600; letter-spacing: .03em; padding: 9px var(--vg-space-4); }
.vg-announce i { color: var(--vg-gold-400); margin-right: 7px; }
.vg-nav { position: sticky; top: 0; z-index: 100; background: rgba(230,231,233,.9); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); box-shadow: 0 1px 0 rgba(18,22,27,.06); }
.vg-nav-inner { display: flex; align-items: center; justify-content: space-between; padding: 18px var(--vg-space-4); max-width: 1180px; margin: 0 auto; }
.vg-logo { font-family: var(--vg-font-display); font-size: 21px; font-weight: 600; letter-spacing: .02em; display: flex; align-items: center; gap: 6px; }
.vg-logo-mark { width: 32px; height: 32px; object-fit: contain; flex-shrink: 0; }
.vg-nav-links { display: flex; gap: var(--vg-space-5); font-size: 14px; font-weight: 500; color: var(--vg-navy-600); }
.vg-nav-links a:hover { color: var(--vg-navy-900); }
@media (max-width: 720px) { .vg-nav-links { display: none; } }
.vg-nav-actions { display: flex; align-items: center; gap: 8px; }
.vg-nav-toggle { display: none; align-items: center; justify-content: center; width: 40px; height: 40px; background: none; border: none; color: var(--vg-navy-900); font-size: 19px; cursor: pointer; -webkit-tap-highlight-color: transparent; flex-shrink: 0; }
@media (max-width: 720px) { .vg-nav-toggle { display: flex; } }
@media (max-width: 640px) { .vg-nav-actions .vg-btn span { display: none; } .vg-nav-actions .vg-btn { padding: 10px 13px; } }
.vg-mobile-menu { display: none; flex-direction: column; background: var(--vg-surface); border-top: 1px solid var(--vg-ivory-200); box-shadow: var(--vg-shadow-md); }
.vg-mobile-menu.vg-mobile-menu-open { display: flex; }
.vg-mobile-menu a { padding: 16px var(--vg-space-4); font-size: 15px; font-weight: 500; color: var(--vg-navy-700); border-bottom: 1px solid var(--vg-ivory-100); }
.vg-mobile-menu a:last-child { border-bottom: none; }
@media (min-width: 721px) { .vg-mobile-menu { display: none !important; } }
.vg-vault-swatches { display: grid; grid-template-columns: repeat(5,1fr); gap: 10px; }
@media (max-width: 520px) { .vg-vault-swatches { grid-template-columns: repeat(4,1fr); } }
@media (max-width: 380px) { .vg-vault-swatches { grid-template-columns: repeat(3,1fr); } }
.vg-reveal { opacity: 0; transform: translateY(36px); transition: opacity 900ms var(--vg-ease-out), transform 900ms var(--vg-ease-out); }
.vg-reveal.vg-in { opacity: 1; transform: translateY(0); }
.vg-reveal[data-delay="1"] { transition-delay: 90ms; }
.vg-reveal[data-delay="2"] { transition-delay: 180ms; }
.vg-reveal[data-delay="3"] { transition-delay: 270ms; }
.vg-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: var(--vg-radius-pill); background: var(--vg-ivory-200); color: var(--vg-navy-600); font-size: 12px; font-weight: 600; letter-spacing: .04em; }
.vg-pill-out { background: #F3E4DC; color: var(--vg-danger); }
.vg-pill-in { background: #E3F0E9; color: var(--vg-success); }
.vg-pill-gold { background: var(--vg-gold-050); color: var(--vg-gold-500); }
.vg-front-back-toggle { display: flex; gap: 8px; }
.vg-fb-btn { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: none; background: var(--vg-ivory-100); color: var(--vg-navy-500); font-family: var(--vg-font-body); font-weight: 600; font-size: 13px; padding: 11px 14px; border-radius: var(--vg-radius-pill); cursor: pointer; transition: background var(--vg-dur-fast) var(--vg-ease-soft), color var(--vg-dur-fast) var(--vg-ease-soft), box-shadow var(--vg-dur-fast) var(--vg-ease-soft); -webkit-tap-highlight-color: transparent; }
.vg-fb-btn:hover { background: var(--vg-ivory-200); }
.vg-fb-btn.vg-fb-active { background: var(--vg-navy-900); color: #fff; box-shadow: var(--vg-shadow-sm); }
.vg-video-frame { position: relative; width: 100%; aspect-ratio: 16/9; border-radius: var(--vg-radius-lg); overflow: hidden; box-shadow: var(--vg-shadow-lg); background: var(--vg-navy-800); }
.vg-video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
@media (max-width: 640px) { .vg-video-frame { border-radius: var(--vg-radius-md); } }
.vg-product-card { overflow: hidden; padding: 0; display: block; text-decoration: none; color: inherit; }
.vg-product-card-img { aspect-ratio: 4/5; background: var(--vg-ivory-50); border-radius: var(--vg-radius-lg) var(--vg-radius-lg) 0 0; overflow: hidden; }
.vg-product-card-img img { width: 100%; height: 100%; object-fit: cover; }
.vg-product-card-body { padding: 18px 20px 22px; }
.vg-form-field { margin-bottom: 18px; }
.vg-form-field label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 7px; color: var(--vg-navy-700); }
.vg-form-field input, .vg-form-field textarea { width: 100%; padding: 13px 16px; border-radius: 12px; border: 1px solid var(--vg-ivory-300); background: var(--vg-surface); font-family: inherit; font-size: 15px; color: var(--vg-text); box-shadow: var(--vg-shadow-xs); transition: border-color var(--vg-dur-fast) var(--vg-ease-soft), box-shadow var(--vg-dur-fast) var(--vg-ease-soft); }
.vg-form-field input:focus, .vg-form-field textarea:focus { outline: none; border-color: var(--vg-gold-400); box-shadow: 0 0 0 3px var(--vg-gold-050); }
.vg-form-field textarea { resize: vertical; }
.vg-nav-cart { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: var(--vg-ivory-50); color: var(--vg-navy-900); font-size: 16px; flex-shrink: 0; -webkit-tap-highlight-color: transparent; transition: background var(--vg-dur-fast) var(--vg-ease-soft); }
.vg-nav-cart:hover { background: var(--vg-ivory-200); }
.vg-nav-cart-badge { position: absolute; top: -4px; right: -4px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 999px; background: var(--vg-gold-500); color: #fff; font-size: 10.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; line-height: 1; }
  </style>
</head>
<body class="vg-root">

  <div class="vg-announce">
    <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
    {{ settings.vg_announcement | default: 'Free US Shipping On Orders Over $50.' }}
  </div>

  <header class="vg-nav">
    <div class="vg-nav-inner">
      <a href="{{ routes.root_url }}" class="vg-logo">
        <img src="{{ 'vaultguards-logo.png' | asset_url }}" alt="" class="vg-logo-mark" style="width:18px; height:18px;" width="18" height="18">
        <img src="{{ 'vaultguards-wordmark-dark.png' | asset_url }}" alt="{{ shop.name }}" style="height:11px; width:auto; display:block;" width="141" height="11">
      </a>
      <nav class="vg-nav-links">
        <a href="{{ routes.root_url }}#shop">Shop</a>
        <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}">The Vault</a>
        <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
      </nav>
      <div class="vg-nav-actions">
        <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}" class="vg-btn vg-btn-gold" style="padding:14px 24px;font-size:14px;white-space:nowrap;" data-vg-haptic="tap">
          <i class="fa-solid fa-vault"></i> <span>Enter the Vault</span>
        </a>
        <a href="{{ routes.cart_url }}" class="vg-nav-cart" aria-label="Cart, {{ cart.item_count }} items" data-vg-haptic="tick">
          <i class="fa-solid fa-bag-shopping"></i>
          <span class="vg-nav-cart-badge" id="vg-nav-cart-count" style="{% if cart.item_count == 0 %}display:none;{% endif %}">{{ cart.item_count }}</span>
        </a>
        <button type="button" class="vg-nav-toggle" id="vg-nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="vg-mobile-menu">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
    <nav class="vg-mobile-menu" id="vg-mobile-menu">
      <a href="{{ routes.root_url }}#shop">Shop</a>
      <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}">The Vault</a>
      <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
    </nav>
  </header>

  <main role="main">
    {{ content_for_layout }}
  </main>

  <footer style="background:var(--vg-navy-900); color:var(--vg-ivory-200); padding:64px 0 32px;">
    <div class="vg-container">
      <div class="vg-footer-grid" style="display:grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap:40px;">
        <div>
          <div class="vg-logo" style="color:#fff; display:flex; align-items:center; gap:10px;">
            <img src="{{ 'vaultguards-logo.png' | asset_url }}" alt="" class="vg-logo-mark" width="32" height="32">
            <img src="{{ 'vaultguards-wordmark.png' | asset_url }}" alt="{{ shop.name }}" style="height:20px; width:auto; display:block;" width="207" height="20">
          </div>
          <p style="color:var(--vg-navy-300); font-size:14px; max-width:280px; margin-top:14px;">
            Precision-fit colorway guards for TAG and PSA graded slabs. Built for collectors who treat their cards like the assets they are.
          </p>
        </div>
        <div>
          <div style="font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--vg-gold-400); margin-bottom:14px;">Shop</div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:14px; color:var(--vg-navy-300);">
            {% for collection in collections %}
              {% assign vg_is_tag = false %}
              {% if collection.handle contains 'tag' %}{% assign vg_is_tag = true %}{% endif %}
              {% if vg_is_tag %}<a href="{{ collection.url }}">TAG Guards</a>{% endif %}
            {% endfor %}
            {% for collection in collections %}
              {% assign vg_is_tag = false %}
              {% assign vg_is_shimmer = false %}
              {% if collection.handle contains 'tag' %}{% assign vg_is_tag = true %}{% endif %}
              {% if collection.handle contains 'shimmer' %}{% assign vg_is_shimmer = true %}{% endif %}
              {% if vg_is_shimmer and vg_is_tag == false %}<a href="{{ collection.url }}">PSA Guards</a>{% endif %}
            {% endfor %}
            <a href="{{ routes.root_url }}#shop">Accessories</a>
          </div>
        </div>
        <div>
          <div style="font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--vg-gold-400); margin-bottom:14px;">Explore</div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:14px; color:var(--vg-navy-300);">
            <a href="{{ pages['the-vault'].url | default: '/pages/the-vault' }}">The Vault: Try It On</a>
            <a href="{{ routes.root_url }}#watch">Watch Once You Buy</a>
          </div>
        </div>
        <div>
          <div style="font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--vg-gold-400); margin-bottom:14px;">Support</div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:14px; color:var(--vg-navy-300);">
            <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
            <a href="{{ pages.shipping.url | default: '#' }}">Shipping</a>
            <a href="{{ pages.faq.url | default: '#' }}">FAQ</a>
          </div>
        </div>
      </div>
      <div style="margin-top:48px; padding-top:24px; border-top:1px solid rgba(255,255,255,.08); display:flex; flex-wrap:wrap; gap:8px 20px; justify-content:space-between; color:var(--vg-navy-400); font-size:13px;">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
        <span>Not affiliated with TAG Grading or PSA.</span>
      </div>
    </div>
  </footer>

  <script>
    window.VG = window.VG || {};
    VG.haptic = {
      _v: function (p) { if (navigator.vibrate) { try { navigator.vibrate(p); } catch (e) {} } },
      tick: function () { this._v(8); },
      tap: function () { this._v(12); },
      success: function () { this._v([10, 40, 10]); },
      warn: function () { this._v([16, 30, 16]); },
      snap: function () { this._v(6); }
    };
    function vgInitRevealObserver() {
      var els = document.querySelectorAll('.vg-reveal');
      if (!('IntersectionObserver' in window) || !els.length) {
        els.forEach(function (el) { el.classList.add('vg-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('vg-in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      els.forEach(function (el) { io.observe(el); });
    }
    function vgInitTapHaptics() {
      document.addEventListener('click', function (e) {
        var t = e.target.closest('[data-vg-haptic]');
        if (!t) return;
        var kind = t.getAttribute('data-vg-haptic');
        if (VG.haptic[kind]) VG.haptic[kind]();
        else VG.haptic.tap();
      });
    }
    function vgInitMobileMenu() {
      var toggle = document.getElementById('vg-nav-toggle');
      var menu = document.getElementById('vg-mobile-menu');
      if (!toggle || !menu) return;
      function closeMenu() {
        menu.classList.remove('vg-mobile-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.innerHTML = '<i class="fa-solid fa-bars"></i>';
      }
      toggle.addEventListener('click', function () {
        var isOpen = menu.classList.toggle('vg-mobile-menu-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.innerHTML = isOpen ? '<i class="fa-solid fa-xmark"></i>' : '<i class="fa-solid fa-bars"></i>';
      });
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', closeMenu);
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 720) closeMenu();
      });
    }
    VG.refreshCartCount = function () {
      fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          var badge = document.getElementById('vg-nav-cart-count');
          if (!badge) return;
          badge.textContent = cart.item_count;
          badge.style.display = cart.item_count > 0 ? 'flex' : 'none';
        })
        .catch(function () {});
    };
    VG.initHapticScroll = function () {
      vgInitRevealObserver();
      vgInitTapHaptics();
      vgInitMobileMenu();
    };
    document.addEventListener('DOMContentLoaded', function () {
      VG.initHapticScroll();
      VG.refreshCartCount();
    });
  </script>

</body>
</html>
